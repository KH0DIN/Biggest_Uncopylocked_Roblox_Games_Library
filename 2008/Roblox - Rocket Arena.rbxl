		<Item class="Script" referent="RBX1852">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Regenerate Castle</string>
				<string name="Source">model = game.Workspace.Regen
messageText = &quot;Regenerating Bridges...&quot;

message = Instance.new(&quot;Message&quot;)
message.Text = messageText
backup = model:clone()

while true do
	wait(300)

	message.Parent = game.Workspace
	model:remove()

	wait(4)

	model = backup:clone()
	model.Parent = game.Workspace
	model:makeJoints()
	message.Parent = nil
end
</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
