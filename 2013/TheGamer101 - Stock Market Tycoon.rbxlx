				<ProtectedString name="Source">--TheGamer101
---The news events.
----Too many tables
local event = {&quot;TheGamer101 relased a new game pass for Sword Fighting Tournament&quot; , &quot;Shedletsky claims sword fighting to be &apos;One of the arts of Roblox&apos;&quot; , &quot;Six Flags adds a new roller coaster.&quot; , &quot;Blog article reveals the mystery of wingman8&quot; , &quot;Sword Fighting Tournament removes Darkheart&quot; , &quot;Welcome to Roblox Building is majorly updated&quot;, &quot;Perilous Skies breaks giving Jet Wars : Advanced Battle a surge of players&quot; , &quot;A new sword fighting game has hit the front page.&quot; ,
&#9;&quot;Fighting games losing popularity as Roblox Devs preach pacifism&quot; , &quot;New V.I.P t-shirt released for Hide and Seek&quot; , &quot;A popular roller coaster in Six Flags has broken down.&quot; , &quot;Call of Robloxia introduces three new guns&quot; , &quot;Glitchs in Galleons yet to be fixed after a few months&quot; , &quot;A copied version of The Underground Wars reaches the front page&quot; , &quot;Catalog Heaven becomes the most played game ever&quot; , &quot;An all new ship has been added to Galleons&quot; , &quot;A competitor to Catalog Heaven has emerged, Catalog Hell.&quot; ,
&#9;&quot;Hide and Seek starts a heavy advertising campaign&quot; , &quot;Roblox releases a blog article praising Galleons&quot; , &quot;A new update breaks the stamper tool.&quot; , &quot;The team deathmatch bonus round in Sword Fighting Tournament has been broken&quot; , &quot;Miked has returned and updated Ultimate Painball&quot; , &quot;Construction of the promised new Paintball map has been delayed&quot; , &quot;A new wave of exploiters have started playing Jet Wars : Advanced Battle after the anti-exploit script broke&quot; , &quot;Safety concerns at The Underground Wars as three die in cave in.&quot; ,
&#9;&quot;Leaked internal documents show reckless disregard for safety at Six Flags&quot; , &quot;Two hiding players have gone missing at Hide and Seek.&quot; , &quot;Sword Fights on the Heights IV announced game of the year at Bloxcon&quot; , &quot;Jet Wars : Advanced Battle creator releases new planes.&quot; , &quot;Catalog Heaven has been made uncopylocked for a limited time&quot; , &quot;Base Wars releases new promotional video&quot; , &quot;TheGamer101 announces he is focusing on Sword Fighting Tournament for the next month. Other projects abandoned.&quot; , &quot;Base Wars creator promises new updates are on the way.&quot; ,
&#9;&quot;Seranok removes a key feature from Catalog Heaven&quot; , &quot;Builderman announces Call of Robloxia is his favourite game&quot; , &quot;New roblox animations make sword fighting harder.&quot; , &quot;A new bonus round has been released in Sword Fighting Tournament.&quot; , &quot;Catalog Heaven adds new soundtrack.&quot; , &quot;Jet Wars : Advanced Battle announces new homing missles system&quot; , &quot;Pirate craze leads to Galleons popularity&quot; , &quot;Ninja enthusiasts sabatoge Galleons.&quot; , &quot;Six Flags introduces new role playing tools.&quot; , &quot;The Underground Wars was voted one of the top ten games on roblox in a recent poll.&quot; ,
&#9;&quot;TheGamer101 starts a new sword fighting group&quot;} ---what happened
local places = {&quot;Sword Fighting Tournament&quot; , &quot;Sword Fighting Tournament/Sword Fights on the Heights IV&quot; , &quot;Six Flags&quot; , &quot;Galleons&quot; , &quot;Sword Fighting Tournament&quot; , &quot;Welcome to Roblox Building&quot; , &quot;Jet Wars : Advanced Battle&quot; , &quot;Sword Fighting Tournament/Sword Fights on the Heights IV&quot; , 
&#9;&quot;Sword Fighting Tournament/Sword Fights on the Heights IV/Catalog Heaven/Call of Robloxia/Base Wars/Galleons/Paintball/The Underground Wars&quot; , &quot;Hide and Seek&quot; , &quot;Six Flags&quot; , &quot;Call of Robloxia&quot; , &quot;Galleons&quot; , &quot;The Underground Wars&quot; , &quot;Catalog Heaven&quot; , &quot;Galleons&quot; , &quot;Catalog Heaven&quot; ,
&#9;&quot;Hide and Seek&quot; , &quot;Galleons&quot; , &quot;Welcome to Roblox Building&quot; , &quot;Sword Fighting Tournament&quot; , &quot;Paintball&quot; , &quot;Paintball&quot; , &quot;Jet Wars : Advanced Battle&quot; , &quot;The Underground Wars&quot; , &quot;Six Flags&quot; , &quot;Hide and Seek&quot; , &quot;Sword Fights on the Heights IV&quot; , &quot;Jet Wars : Advanced Battle&quot; , &quot;Catalog Heaven&quot; ,
&#9;&quot;Base Wars&quot; , &quot;Sword Fighting Tournament&quot; , &quot;Base Wars&quot; , &quot;Catalog Heaven&quot; , &quot;Call of Robloxia&quot; , &quot;Sword Fighting Tournament/Sword Fights on the Heights IV&quot; , &quot;Sword Fighting Tournament&quot; , &quot;Catalog Heaven&quot; , &quot;Jet Wars : Advanced Battle&quot; , &quot;Galleons&quot; , &quot;Galleons&quot; , &quot;Six Flags&quot; , &quot;The Underground Wars&quot; , 
&#9;&quot;Sword Fighting Tournament&quot;} ---who will this affect
local effect = {0.9 , 1 , 1 , 0.7 , -1 , 0.6 , 0.9 , -0.8 , -1 , 1 , -0.8 , 0.9 , -1 , -0.9 , 1 , 0.6 , -1 , 0.8 , 0.6 , -1 , -0.8 , -0.7 , -0.5 , -0.8 , -0.8 , -0.7 , -0.3 , 1 , 1 , 0.8 , 0.9 , 1 , 0.8 , -1 , 1 , -0.7 , 0.9 , 0.7 , 0.8 , 1 , -1 , 0.8 , 0.9 , 0.7} ---how will this affect them
local time1 = {&quot;2/4&quot; , &quot;3/6&quot; , &quot;1/2&quot; , &quot;2/5&quot; , &quot;1/3&quot; , &quot;2&quot; , &quot;3/6&quot; , &quot;3/4&quot; , &quot;2/4&quot; , &quot;1&quot; , &quot;4&quot; , &quot;2/3&quot; , &quot;7&quot; , &quot;2/5&quot; , &quot;2/5&quot; ,&quot;1/7&quot; , &quot;3&quot; , &quot;2/4&quot; , &quot;3/6&quot; , &quot;2/6&quot; , &quot;1/4&quot; , &quot;3/4&quot; , &quot;1/2&quot; , &quot;3/4&quot; , &quot;3/4&quot; , &quot;2/3&quot; , &quot;1/2&quot; , &quot;3/4&quot; , &quot;2/5&quot; , &quot;2/3&quot; , &quot;1/5&quot; , &quot;10/20&quot; , &quot;3/4&quot; , &quot;2/5&quot; , &quot;3/4&quot; , &quot;2/3&quot; , &quot;3/4&quot; , &quot;1/2&quot; , &quot;4/5&quot; , &quot;3/6&quot; , &quot;3/5&quot; , &quot;2/4&quot; , &quot;4/6&quot; , &quot;2/3&quot;} ---how long will this event last?

----The insider events.
local ievent = {&quot;TheGamer101 : Just started making a new bonus round for SFT&quot; , &quot;TheGamer101 : I am considering adding a new map to SFT&quot; , &quot;d4rk886 : I plan on adding new guns to Base Wars&quot; , &quot;daxter33 : A new Paintball update is coming out very soon&quot; , &quot;Wingman8 : I plan on removing some ships from Galleons to reduce lag&quot; , &quot;litozinnamon : The new Call of Robloxia update has been delayed&quot; , &quot;Seranok : I plan on releasing a new gamepass for Catalog Heaven&quot; , &quot;Jacob6441443 : I am focusing my attention on other games than Six Flags.&quot; , &quot;Stickmasterluke : I am working on some anti-exploit measures for The Underground Wars&quot; , &quot;lando64000 : I plan on adding a new map to Hide and Seek soon&quot; , &quot;daxter33 : I am planning to reset the levels in Paintball&quot; , &quot;Carbon131 : I am creating new jets for Jet Wars&quot; , &quot;daxter33 : I am working on a new animations system for paintball&quot; , 
&quot;Seranok : I am working on a new gamepass for catalog heaven&quot; , &quot;Stickmasterluke : The Underground Wars will be revamped soon&quot; , &quot;TheGamer101 : I plan on lowering the damages of high powered swords in SFT&quot; , &quot;Stickmasterluke : I have decided to add data persistance to The Underground Wars&quot; , &quot;d4rk886 : I will add new guns to Base Wars soon&quot; , &quot;litozinnamon : I am adding a new selection of badges to Call of Robloxia 5&quot; , &quot;Jacob6441443 : I am working on a new roller coaster for Six Flags&quot; , &quot;d4rk886 : Some of the most over powered weapons will be removed from Base Wars&quot; , &quot;TheGamer101 : The wins cost of the top swords will be increased in SFT&quot; , &quot;Carbon131 : I will soon lose BC and be unable to sell gamepasses or award badges&quot; , &quot;Shedletsky : I will be updating Sword Fights on the Heights soon, I promise&quot; , &quot;Shedletsky : I am removing all the swords but normal swords from SFoTH on a trial basis&quot; ,
&quot;Seranok : I am removing a lot of over powered gear from catalog heaven&quot; , &quot;Wingman8 : The guns in Galleons will be removed an replaced with swords temporarily&quot;}  --The insider event
local iplace = {&quot;Sword Fighting Tournament&quot; , &quot;Sword Fighting Tournament&quot; , &quot;Base Wars&quot; , &quot;Paintball&quot; , &quot;Galleons&quot; , &quot;Call of Robloxia&quot; , &quot;Catalog Heaven&quot; , &quot;Six Flags&quot; , &quot;The Underground Wars&quot; , &quot;Hide and Seek&quot; , &quot;Paintball&quot; , &quot;Jet Wars : Advanced Battle&quot; , &quot;Paintball&quot; ,
&quot;Catalog Heaven&quot; , &quot;The Underground Wars&quot; , &quot;Sword Fighting Tournament&quot; , &quot;The Underground Wars&quot; , &quot;Base Wars&quot; , &quot;Call of Robloxia&quot; , &quot;Six Flags&quot; , &quot;Base Wars&quot; , &quot;Sword Fighting Tournament&quot; , &quot;Jet Wars : Advanced Battle&quot; , &quot;Sword Fights on the Heights IV&quot; , &quot;Sword Fights on the Heights IV&quot; ,
&quot;Catalog Heaven&quot; , &quot;Galleons&quot;} ---The place it effects
local ieffect = {0.9 , 0.7 , 1 , 1 , -1 , -0.8 , 0.9 , -1 , 1 , 0.8 , -1 , 0.9 , 0.9 , 0.8 , 0.9 , -1 , 0.8 , 0.9 , 1 , 0.8 , -1 , -1 , -0.7 , 0.8 , -0.7 , -0.9 , -0.6} ---The effect
local itime1 = {&quot;4/5&quot; , &quot;4&quot; , &quot;3/5&quot; , &quot;3/4&quot; , &quot;2/8&quot; , &quot;3/4&quot; , &quot;4/7&quot; , &quot;3/4&quot; , &quot;3/4&quot; , &quot;3/5&quot; , &quot;4/6&quot; , &quot;3/4&quot; , &quot;3/5&quot; , &quot;3/4&quot; , &quot;5/8&quot; , &quot;5/8&quot; , &quot;4/5&quot; , &quot;2/3&quot; , &quot;4/5&quot; , &quot;3/5&quot; , &quot;4/7&quot; , &quot;3/6&quot; , &quot;3/4&quot; , &quot;3/4&quot; , &quot;3/4&quot; , &quot;3/6&quot; , &quot;3/4&quot;} ---time it lasts
local itime2 = {3 , 2 , 5 , 3 , 3 , 2 , 3 , 3 , 2 , 4 , 3 , 4 , 2 , 3 , 10 , 4 , 3 , 2 , 3 , 3 , 4 , 3 , 2 , 4 , 2 , 3 , 5 , 2} ---time until it starts

print(#effect)
print(#event)
print(#time1)
print(#places)

---the globals needed for the gui

_G.EventHappened = {} --what happened
_G.Time = {} ---how long ago

_G.InsideHappened = {} --- What insider information happened
_G.Time2 = {} --- how long ago

---the globals need for the stocks going up or down
_G.Games = {} ---the place this will effect
_G.Change = {} ---up or down
_G.TimeUntil = {} ---how long until it has an effect

---the code

function hashappened(eventname)
&#9;for i = 1, #_G.EventHappened do
&#9;&#9;if _G.EventHappened[i] == eventname then
&#9;&#9;return true
&#9;&#9;end
&#9;end
&#9;for i = 1, #_G.InsideHappened do
&#9;&#9;if _G.InsideHappened[i] == eventname then
&#9;&#9;return true
&#9;&#9;end
&#9;end
return false
end

function split(s1) --split a string into it&apos;s components
local components = {}
local start = 1
&#9;for i = 1, s1:len() do
&#9;&#9;if string.sub(s1 , i , i) == &quot;/&quot; then
&#9;&#9;table.insert(components , string.sub(s1 , start , i - 1))
&#9;&#9;start = i + 1
&#9;&#9;end
&#9;end
table.insert(components , string.sub(s1 , start , s1:len()))
return components
end

function genevent()
local pick = math.random(1 , #event)
&#9;if hashappened(event[pick]) then
&#9;genevent()
&#9;else
&#9;--can happen
&#9;table.insert(_G.EventHappened, 1 , event[pick])  ---first get the info out to the players
&#9;table.insert(_G.Time , 1 , 0)
&#9;&#9;if #_G.EventHappened &gt; 10 then
&#9;&#9;table.remove(_G.EventHappened , 11)
&#9;&#9;table.remove(_G.Time , 11)
&#9;&#9;end
&#9;---will it have an effect
&#9;local c1 = math.abs(effect[pick]*10)  --- 1 = 10, 0.5 = 5 ect.
&#9;local check = math.random(1 , 10)
&#9;&#9;if check &lt;= c1 then
&#9;&#9;---now find out what games this effects.
&#9;&#9;local gamestab = split(places[pick])
&#9;&#9;---find the time
&#9;&#9;local time21 = 0
&#9;&#9;local time22 = 0
&#9;&#9;local timevals = split(time1[pick])
&#9;&#9;time21 = timevals[1]
&#9;&#9;&#9;if #timevals &gt;= 2 then
&#9;&#9;&#9;time21 = math.random(timevals[1] , timevals[2])
&#9;&#9;&#9;end
&#9;&#9;&#9;for h = 1, time21 do
&#9;&#9;&#9;&#9;for x =1, #gamestab do
&#9;&#9;&#9;&#9;table.insert(_G.Games , gamestab[x])
&#9;&#9;&#9;&#9;table.insert(_G.TimeUntil , x - 1)
&#9;&#9;&#9;&#9;---is the change up or down?
&#9;&#9;&#9;&#9;&#9;if effect[pick] &lt; 0 then
&#9;&#9;&#9;&#9;&#9;table.insert(_G.Change , -1)
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;table.insert(_G.Change , 1)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
local changedit = game.Workspace:FindFirstChild(&quot;DataChanged&quot;)
&#9;if changedit then
&#9;changedit.Value = not changedit.Value
&#9;end
end

function movetime() --every event is geting older
&#9;for i = 1, #_G.Time do
&#9;_G.Time[i] = _G.Time[i] + 1
&#9;end
&#9;for i = 1, #_G.Time2 do
&#9;_G.Time2[i] = _G.Time2[i] + 1
&#9;end
end

function getnumber()
local events = math.random(1 , 40)
&#9;if events &lt; 5 then
&#9;events = 1
&#9;elseif events &lt; 15 then
&#9;events = 2
&#9;elseif events &lt; 35 then
&#9;events = 3
&#9;else
&#9;events = 4 
&#9;end
return events
end

function geninsider()
local pick = math.random(1 , #ievent)
&#9;if hashappened(ievent[pick]) then
&#9;geninsider()
&#9;else
&#9;table.insert(_G.InsideHappened, 1 , ievent[pick])  ---first get the info out to the players
&#9;table.insert(_G.Time2 , 1 , 0)
&#9;&#9;if #_G.InsideHappened &gt; 10 then
&#9;&#9;table.remove(_G.InsideHappened , 11)
&#9;&#9;table.remove(_G.Time2 , 11)
&#9;&#9;end
&#9;---will it have an effect
&#9;local c1 = math.abs(ieffect[pick]*10)  --- 1 = 10, 0.5 = 5 ect.
&#9;local check = math.random(1 , 10)
&#9;&#9;if check &lt;= c1 then
&#9;&#9;---now find out what games this effects.
&#9;&#9;local gamestab = split(iplace[pick])
&#9;&#9;---find the time
&#9;&#9;local time21 = 0
&#9;&#9;local time22 = 0
&#9;&#9;local timevals = split(itime1[pick])
&#9;&#9;time21 = timevals[1]
&#9;&#9;&#9;if #timevals &gt;= 2 then
&#9;&#9;&#9;time21 = math.random(timevals[1] , timevals[2])
&#9;&#9;&#9;end
&#9;&#9;&#9;for h = 1, time21 do
&#9;&#9;&#9;&#9;for x =1, #gamestab do
&#9;&#9;&#9;&#9;table.insert(_G.Games , gamestab[x])
&#9;&#9;&#9;&#9;table.insert(_G.TimeUntil , x - 1 + itime2[pick])
&#9;&#9;&#9;&#9;---is the change up or down?
&#9;&#9;&#9;&#9;&#9;if ieffect[pick] &lt; 0 then
&#9;&#9;&#9;&#9;&#9;table.insert(_G.Change , -1)
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;table.insert(_G.Change , 1)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
local changedit = game.Workspace:FindFirstChild(&quot;DataChanged&quot;)
&#9;if changedit then
&#9;changedit.Value = not changedit.Value
&#9;end
end

function rungame(waitval)  ----run a 2 minutes hour of the game
local events = getnumber()
local insiderevents = getnumber()
&#9;local runinsider = coroutine.wrap(function()
&#9;&#9;for x = 1, insiderevents do
  &#9;&#9;wait(waitval/insiderevents)
&#9;&#9;geninsider()
&#9;&#9;end
&#9;end)
&#9;runinsider()
&#9;for i =1, events do
&#9;genevent()
&#9;wait(waitval/events)  ---wait
&#9;end
movetime()
end

--starting off, lets get ten fake events
&#9;for o =1, 10 do
&#9;rungame(0)
&#9;end
while true do
rungame(120)  ---120 seconds yo.
end
