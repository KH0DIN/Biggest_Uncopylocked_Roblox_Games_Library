			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">TycoonManager</string>
				<ProtectedString name="Source">---TheGamer101

function leaving()
wait(1)
local plots = game.Workspace.Bricks.Plots
local houses = game.Workspace.Bricks.Houses
&#9;for i = 1, 6 do
&#9;local theplot = plots:FindFirstChild(&quot;Plot&quot; ..i)
&#9;&#9;if theplot then
&#9;&#9;local owner = theplot.Owner.Value
&#9;&#9;&#9;if owner ~= &quot;/Save&quot; then
&#9;&#9;&#9;local player = game.Players:FindFirstChild(owner)
&#9;&#9;&#9;&#9;if player == nil then
&#9;&#9;&#9;&#9;theplot.Owner.Value = &quot;/None&quot;
&#9;&#9;&#9;&#9;local marker = plots:FindFirstChild(&quot;Owner&quot; ..i)
&#9;&#9;&#9;&#9;&#9;if marker then
&#9;&#9;&#9;&#9;&#9;marker.ShowOwner.Text1.Text = &quot;No one owns this plot&quot;
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;local house = houses:FindFirstChild(owner)
&#9;&#9;&#9;&#9;&#9;if house then
&#9;&#9;&#9;&#9;&#9;house:Destroy()
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end&#9;&#9;
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
game.Players.PlayerRemoving:connect(leaving)

function teleport(player3 , loc)
player3.Character.Torso.CFrame = loc
&#9;if player3.Character.Torso.CFrame ~= loc then
&#9;wait()
&#9;teleport(player3 , loc)
&#9;end
end

function getplot(owner)
local plots = game.Workspace.Bricks.Plots
local plot = nil
&#9;for x =1, 6 do
&#9;local theplot = plots:FindFirstChild(&quot;Plot&quot; ..x)
&#9;&#9;if theplot then
&#9;&#9;&#9;if theplot.Owner.Value == &quot;/None&quot; then
&#9;&#9;&#9;&#9;if plot == nil then
&#9;&#9;&#9;&#9;plot = theplot
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;elseif theplot.Owner.Value == owner.Name then
&#9;&#9;&#9;plot = theplot
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
return plot&#9;
end

function getside(plotnumber)
&#9;if plotnumber % 2 == 0 then
&#9;return 2
&#9;end
return 1
end

function movemod(model , xval , yval , zval)
local scr1 = game.Lighting.Scripts.PositionTest:Clone()
scr1.Parent = model
scr1.XVal.Value = xval
scr1.YVal.Value = yval
scr1.ZVal.Value = zval
wait(0.1)
scr1.Chang1.Value = true
end

function ModelCFrame(Model, NewCFrame)
Model:MoveTo(NewCFrame.p)
local Origins = {}
&#9;for i,v in pairs( Model:GetChildren() ) do
&#9;&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;Origins[v] = Model:GetModelCFrame():toObjectSpace(v.CFrame)
&#9;&#9;end
&#9;end
&#9;for i,v in pairs(Origins) do
&#9;i.CFrame = NewCFrame:toWorldSpace(v)
&#9;end
end

local firstone = true

function entered(player)
&#9;if firstone then
&#9;firstone = false
&#9;game.Lighting.Scripts.GetBrickForModel:Clone().Parent = game.Workspace.LoadScripts
&#9;game.Lighting.Scripts.PositionTest:Clone().Parent = game.Workspace.LoadScripts
&#9;game.Workspace.LoadScripts:Destroy()
&#9;end
local x = Instance.new(&quot;IntValue&quot;)
x.Name = &quot;TycoonNumber&quot;
x.Parent = player
x.Value = 1
&#9;player.CharacterAdded:connect(function(character) 
&#9;local houses = game.Workspace.Bricks.Houses
&#9;local findtycoon = houses:FindFirstChild(player.Name)
&#9;&#9;if findtycoon then
&#9;&#9;game.Lighting.Scripts.TycoonScript:Clone().Parent = character.Torso
&#9;&#9;end
&#9;end)
wait(1)
&#9;if player then
&#9;local newplot = getplot(player)
&#9;&#9;if newplot then
&#9;&#9;&#9;if game:GetService(&quot;GamePassService&quot;):PlayerHasPass(player, 120111332) then
&#9;&#9;&#9;_G.GiveHouse(player , &quot;HouseObject&quot;)
&#9;&#9;&#9;else
&#9;&#9;&#9;_G.GiveHouse(player , &quot;BungalowObject&quot;)
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;player:Destroy()
&#9;&#9;end
&#9;end
end
game.Players.PlayerAdded:connect(entered)

local nameshouses = {&quot;BungalowObject&quot; , &quot;HouseObject&quot; , &quot;MansionObject&quot;}
local badgeids = {119850578 , 119850626 , 119850673}

function awardhousebadge(player , housename)
&#9;for i = 1, #nameshouses do
&#9;&#9;if nameshouses[i] == housename then
&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId , badgeids[i])
&#9;&#9;end
&#9;end
end

function _G.GiveHouse(player , house)
awardhousebadge(player, house)
local findhouse = game.Lighting.HouseModels:FindFirstChild(house)
local plots = game.Workspace.Bricks.Plots
local houses = game.Workspace.Bricks.Houses
&#9;if findhouse then
&#9;---find if they already have a house.
&#9;local has = houses:FindFirstChild(player.Name)
&#9;&#9;if has then
&#9;&#9;&#9;if has.Name == house then
&#9;&#9;&#9;return 0  ---0 for you already have that house
&#9;&#9;&#9;end
&#9;&#9;end
&#9;local plot = getplot(player)
&#9;&#9;if plot then
&#9;&#9;---plots 1 , 3 and 5 are to the left of the road
&#9;&#9;---plots 2 , 4 , and 6 are to the right of the road
&#9;&#9;---HouseObject and BungalowObjects natural positions are to the left of the road
&#9;&#9;---MansionObjects natural position is to the right of the road.
&#9;&#9;local oldhouse = houses:FindFirstChild(player.Name)
&#9;&#9;&#9;if oldhouse then
&#9;&#9;&#9;oldhouse:Destroy()
&#9;&#9;&#9;end
&#9;&#9;local plotnumber = tonumber(string.sub(plot.Name , 5))
&#9;&#9;local side = getside(plotnumber)  --1 for left, 2 for right
&#9;&#9;local marker1 = plots:FindFirstChild(&quot;RoadMarker&quot; ..tonumber(side))
&#9;&#9;local marker2 = plots:FindFirstChild(&quot;SideMarker&quot; ..tonumber(side))
&#9;&#9;---get the player a new house
&#9;&#9;local newhouse = findhouse:Clone()
&#9;&#9;newhouse.Parent = game.Workspace.Bricks.Houses
&#9;&#9;---check does it need to turn
&#9;&#9;print(&quot;Side : &quot; ..side)
&#9;&#9;---find the postition
&#9;&#9;local x1 = (plot.Marker1.Position.X + plot.Marker2.Position.X)/2
&#9;&#9;local y1 = 0  ----doesn&apos;t matter. Isn&apos;t used
&#9;&#9;local z1 = (marker1.Position.Z + marker2.Position.Z)/2
&#9;&#9;movemod(newhouse , x1 , y1 , z1)
&#9;&#9;--May not work
&#9;&#9;&#9;if side == 1 then
&#9;&#9;&#9;&#9;if newhouse.Name == &quot;MansionObject&quot; or newhouse.Name == &quot;TradeBuilding&quot; then
&#9;&#9;&#9;&#9;ModelCFrame(newhouse, newhouse:GetModelCFrame()*CFrame.Angles(0,math.pi,0))
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;if newhouse.Name ~= &quot;MansionObject&quot; and newhouse.Name ~= &quot;TradeBuilding&quot; then
&#9;&#9;&#9;&#9;ModelCFrame(newhouse, newhouse:GetModelCFrame()*CFrame.Angles(0,math.pi,0))
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end 
&#9;&#9;newhouse.Name = player.Name
&#9;&#9;plot.Owner.Value = player.Name
&#9;&#9;local showowner = plots:FindFirstChild(&quot;Owner&quot; ..plotnumber)
&#9;&#9;showowner.ShowOwner.Text1.Text = &quot;Tycoon Owner : &quot; ..player.Name
&#9;&#9;local newCFrame = CFrame.new((plot.Marker1.Position.X + plot.Marker2.Position.X)/2 , marker1.Position.Y , marker1.Position.Z)
&#9;&#9;wait(2)
&#9;&#9;&#9;if player.Character then
&#9;&#9;&#9;&#9;if player.Character:FindFirstChild(&quot;Torso&quot;) then
&#9;&#9;&#9;&#9;teleport(player, newCFrame)
&#9;&#9;&#9;&#9;&#9;if player.Character.Torso:FindFirstChild(&quot;TycoonScript&quot;) then
&#9;&#9;&#9;&#9;&#9;player.Character.Torso.TycoonScript:Destroy()
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;game.Lighting.Scripts.TycoonScript:Clone().Parent = player.Character.Torso
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;return 1 ---1 for no space for your house&#9;
&#9;&#9;end
&#9;end
return 2
end


</ProtectedString>
			</Properties>
