		<Item class="Script" referent="RBX589">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">AutoRegen</string>
				<ProtectedString name="Source">function createvalue()
local value = Instance.new(&quot;BoolValue&quot;)
value.Name = &quot;CheckR&quot;
value.Parent = game.Workspace
value.Value = true
end

function checkforregen()
local value = game.Workspace:FindFirstChild(&quot;CheckR&quot;)
&#9;if value then
&#9;value.Value = false
&#9;wait(5)
&#9;&#9;if value.Value == false then
&#9;&#9;local script = game.Workspace:FindFirstChild(&quot;Main_Script&quot;)
&#9;&#9;script:Destroy()
&#9;&#9;local clone = game.Lighting.Scripts:FindFirstChild(&quot;Main_Script&quot;)
&#9;&#9;clone:Clone().Parent = game.Workspace
&#9;&#9;end
&#9;else
&#9;createvalue()
&#9;end
end

while true do
wait(10)
checkforregen()
end

</ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX590">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Main_Script</string>
				<ProtectedString name="Source">--Stock Market Tycoon, TheGamer101

repeat wait() until _G.Games--Global table takes a fraction of a second to initialise

local dividendtime = 60     ---pay dividends every ___ seconds
local updatestockstime = 60 ---update stocks every ___ seconds
local stocks = {10000, 15000}
local cashvals = {1000, 1500}
local vipdividend = {10, 15}

function changebool()
local bool = game.Workspace:FindFirstChild(&quot;CheckR&quot;)
&#9;if bool then
&#9;bool.Value = true
&#9;end
end

function wa_it(time1)
&#9;repeat 
&#9;changebool()
&#9;time1 = time1 - 1
&#9;wait(1)
&#9;changebool()
&#9;until time1 &lt; 1
&#9;changebool()
&#9;wait(time1)
&#9;changebool()
end

function findintable(val, table)
&#9;for b = 1, #table do
&#9;&#9;if table[b] == val then
&#9;&#9;return true
&#9;&#9;end
&#9;end
return false
end

local worths = {20000 , 40000 , 100000 , 500000 , 1000000}
local badgeids = {119850144 , 119850194 , 119850398 , 119850440 , 119850476}

function awardbadge(player , worth)
&#9;if player then
&#9;&#9;for g = 1, #worths do
&#9;&#9;&#9;if worth &gt; worths[g] then
&#9;&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId , badgeids[g])
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function message(Players , text1)
&#9;if Players == &quot;_All&quot; then
&#9;local p1 = game.Players:GetChildren()
&#9;&#9;for l = 1, #p1 do
&#9;&#9;local gui = p1[l].PlayerGui:FindFirstChild(&quot;Text&quot;)
&#9;&#9;&#9;if gui == nil then
&#9;&#9;&#9;local gooey = game.Lighting.Text:Clone()
&#9;&#9;&#9;gooey.Parent = p1[l].PlayerGui
&#9;&#9;&#9;gooey.Frame.Current.Text = text1
&#9;&#9;&#9;else
&#9;&#9;&#9;gui.Frame.Current.Text = text1
&#9;&#9;&#9;end
&#9;&#9;end
&#9;else
&#9;local p1 = game.Players:FindFirstChild(Players)
&#9;&#9;if p1 ~= nil then
&#9;&#9;local gui = p1.PlayerGui:FindFirstChild(&quot;Text&quot;)
&#9;&#9;&#9;if gui == nil then
&#9;&#9;&#9;local gooey = game.Lighting.Text:Clone()
&#9;&#9;&#9;gooey.Parent = p1.PlayerGui
&#9;&#9;&#9;gooey.Frame.Current.Text = text1
&#9;&#9;&#9;else
&#9;&#9;&#9;gui.Frame.Current.Text = text1
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end 


function checkvip(player)
&#9;if game:GetService(&quot;GamePassService&quot;):PlayerHasPass(player, 119849586) == true then  ----VIP line
&#9;---game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId, 69262978)   ---- bottum tier vip badge
&#9;return 2    
&#9;end
return 1
end

function getStocksForPlayer(enteredplayer, amount)
local currentvalues = game.Lighting.StocksValues[&quot;0&quot;]:GetChildren()
local newdatamodel = Instance.new(&quot;Model&quot;)
newdatamodel.Name = enteredplayer.Name
&#9;for a = 1, #currentvalues do
&#9;int = Instance.new(&quot;IntValue&quot;)
&#9;int.Name = currentvalues[a].Name
&#9;int.Value = 0
&#9;int.Parent = newdatamodel
&#9;end
local worth = 0
&#9;while worth &lt; amount do      ----really bad way to do this....
&#9;--wa_it()
&#9;ran = math.random(1, #currentvalues)
&#9;worth = worth + currentvalues[ran].Value
&#9;newdatamodel[currentvalues[ran].Name].Value = newdatamodel[currentvalues[ran].Name].Value + 1
&#9;end
newdatamodel.Parent = game.Lighting.StocksDataModels
enteredplayer:SaveInstance(enteredplayer.Name, newdatamodel)
return worth      ----actuall net worth...
end

---Entered function needs to assign stocks for the player, or get their old stocks
---If both a players cash on hand and stocks are 0, treat them as a new player
---If a player is a VIP then check have they recieved their bonus withing the last day, if not give them extra stocks
function onPlayerEntered(newPlayer)
-----game:GetService(&quot;BadgeService&quot;):AwardBadge(newPlayer.userId, 69668323)  ---Played badge
local vipval = checkvip(newPlayer)      -----VIPs get extra stocks...
newPlayer:WaitForDataReady()
local stats = Instance.new(&quot;IntValue&quot;)
stats.Name = &quot;leaderstats&quot;
stats.Parent = newPlayer
local cash
pcall(function() cash = newPlayer:LoadNumber(&quot;CashonHand&quot;) end)
&#9;if cash == nil then 
&#9;cash = cashvals[vipval]
&#9;end
local oh = Instance.new(&quot;IntValue&quot;)
oh.Name = &quot;Cash on Hand&quot;
oh.Parent = stats
oh.Value = cash
---Assign the player stocks here, check what stocks they actually have already.
local DataModel = nil
local success = pcall(function() DataModel = newPlayer:LoadInstance(newPlayer.Name) end)   ----The stocks model should be saved as the players name
local networth = 0
&#9;if not success or DataModel == nil then
    local worth = getStocksForPlayer(newPlayer, stocks[vipval])
&#9;networth = cash + worth
&#9;else
&#9;local currentvalues = game.Lighting.StocksValues[&quot;0&quot;]:GetChildren()
&#9;local data = DataModel:GetChildren()
&#9;&#9;---Find the amount the stocks in the data model are worth...
&#9;&#9;for q = 1, #currentvalues do
&#9;&#9;networth = networth + (currentvalues[q].Value*DataModel[currentvalues[q].Name].Value)&#9;
&#9;&#9;end
&#9;DataModel.Parent = game.Lighting.StocksDataModels
&#9;networth = networth + cash  -----------Assign net worth before here
&#9;end
&#9;if networth &lt;= 1000 then      ---They lost everything ._.   thanks, Obama
&#9;oh.Value = cashvals[vipval]   ---Treat them as a new player
   &#9;local worth = getStocksForPlayer(newPlayer, stocks[vipval])  
&#9;networth = cashvals[vipval] + worth
&#9;end
local nw = Instance.new(&quot;IntValue&quot;)
nw.Name = &quot;Net Worth&quot;
nw.Changed:connect(function(value1) awardbadge(newPlayer , value1) end)
nw.Parent = stats
nw.Value = networth
end
game.Players.PlayerAdded:connect(onPlayerEntered)


----Save stocks on leaving
game.Players.PlayerRemoving:connect(function(playerleav)
&#9;pcall(function() playerleav:SaveNumber(&quot;CashonHand&quot;, playerleav.leaderstats[&quot;Cash on Hand&quot;].Value) end) 
&#9;pcall(function() playerleav:SaveInstance(playerleav.Name, game.Lighting.StocksDataModels[playerleav.Name]) end) 
&#9;if game.Lighting.StocksDataModels:FindFirstChild(playerleav.Name) ~= nil then
&#9;game.Lighting.StocksDataModels:FindFirstChild(playerleav.Name):Remove()
&#9;end
end)

---Dividends currently calculated as a percentage, could base it on the recent performance of the company
---Dividends could depend on news and the recent stock performance
function paydividends()
message(&quot;_All&quot; , &quot;Dividends being paid...&quot;)
player = game.Players:GetChildren()
wa_it(2)
&#9;for div = 1, #player do
&#9;local DataModel = game.Lighting.StocksDataModels:FindFirstChild(player[div].Name) 
&#9;local currentvalues = game.Lighting.StocksValues[&quot;0&quot;]:GetChildren()
&#9;local networth = 0
&#9;&#9;if not DataModel then
&#9;&#9;wa_it(1)
&#9;&#9;DataModel = game.Lighting.StocksDataModels:FindFirstChild(player[div].Name)&#9;
&#9;&#9;end
&#9;&#9;---Find the amount the stocks in the data model are worth
&#9;&#9;for q = 1, #currentvalues do
&#9;&#9;networth = networth + (currentvalues[q].Value*DataModel[currentvalues[q].Name].Value)&#9;
&#9;&#9;end
&#9;local vipval = checkvip(player[div])
&#9;local dividend = math.floor(networth*(math.random(1, vipdividend[vipval])/100))
&#9;player[div].leaderstats[&quot;Cash on Hand&quot;].Value = player[div].leaderstats[&quot;Cash on Hand&quot;].Value + dividend
&#9;player[div].leaderstats[&quot;Net Worth&quot;].Value = player[div].leaderstats[&quot;Net Worth&quot;].Value + dividend
&#9;pcall(function() player[div]:SaveNumber(&quot;CashonHand&quot;, player[div].leaderstats[&quot;Cash on Hand&quot;].Value) end) 
&#9;message(player[div].Name, &quot;You were paid &quot; ..tostring(dividend).. &quot;$ in dividends.&quot;)
&#9;end
wa_it(3)
end

function shiftevents()
&#9;for g = 1, #_G.TimeUntil do
&#9;&#9;if _G.TimeUntil[g] then
&#9;&#9;_G.TimeUntil[g] = _G.TimeUntil[g] - 1
&#9;&#9;&#9;if _G.TimeUntil[g] &lt; 0 then
&#9;&#9;&#9;table.remove(_G.TimeUntil , g)
&#9;&#9;&#9;table.remove(_G.Games , g)
&#9;&#9;&#9;table.remove(_G.Change , g)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function finddir(average , newstock , change)
&#9;if math.abs(average - change + 1) &lt; math.abs(average - change - 1) then
&#9;return -1&#9;
&#9;else
&#9;return 1
&#9;end
end

function normalise(value , name)
local value2 = value
--- acceptable range around the median = 300.
local stocks = game.Lighting.StocksValues
local stocktable = {}
&#9;for x = 0, 10 do
&#9;local stockmod = stocks[tostring(x)]
&#9;local thestock = stockmod[name]
&#9;table.insert(stocktable , thestock.Value)
&#9;end
local doit = false
&#9;repeat
&#9;if stocktable[1] + value2 &lt; 20 then
&#9;value2 = value2 + 20
&#9;else
&#9;doit = true
&#9;end
&#9;until doit
local notaverage = 0
&#9;for i = 1, #stocktable do
&#9;notaverage = notaverage + stocktable[i]
&#9;notaverage = math.floor(notaverage/2 + 0.5)
&#9;end
local average = 0
&#9;for i = 1, #stocktable do
&#9;average = average + stocktable[i]
&#9;end
average = math.floor(average/#stocktable + 0.5)
print(&quot;Stockname : &quot; ..name)
print(&quot;Current stock value : &quot; ..stocktable[1])  ---The current stock value
print(&quot;Projected new stock value : &quot; ..(stocktable[1] + value2))
print(&quot;Value to change by : &quot; ..value2) 
print(&quot;Average value : &quot; ..average)
print(&quot;Notavarage value : &quot; ..notaverage)
---do stuff
local value13 = (average + notaverage)/2   ---the average value
local newvalue = stocktable[1] + value2 ---the last stock value + the value to change by
local difference = math.abs(value13 - newvalue) ---the difference between the average value and the newvalue it would be
print(&quot;Difference : &quot; ..difference)
print(&quot;value13 : &quot; ..value13)
print(&quot;value13*0.5 : &quot; ..value13*0.5)
print(&quot;direction : &quot; ..finddir(value13 , newvalue , value2))  ---if value13 is greater than newvalue, direction should be 1
local change2 = false
&#9;if difference &gt; value13*5 then
&#9;change2 = true
&#9;print(&quot;NEEDS SPECIAL CHANGE!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!&quot;)
&#9;end
direction = -1
local stop = false
&#9;repeat 
&#9;--wa_it()
&#9;--print(&quot;Value2 is &quot; ..value2)
&#9;&#9;if difference &gt; value13*0.25 then  ---if the difference between average and the projected is too high, make it lower
&#9;&#9;value2 = value2 + 1*direction
&#9;&#9;&#9;if value2 &lt; -1000 then  ---should go down, then up
&#9;&#9;&#9;print(&quot;Reached 0&quot;)
&#9;&#9;&#9;direction = 1
&#9;&#9;&#9;end
&#9;&#9;newvalue = stocktable[1] + value2
&#9;&#9;difference = math.abs(value13 - newvalue)
&#9;&#9;else
&#9;&#9;stop = true
&#9;&#9;end
&#9;until stop
&#9;if change2 then
&#9;value2 = math.sqrt(math.abs(value2))*(value2/value2)
&#9;end
print(&quot;Normalised value : &quot; ..value2)
return value2
end

function findevent(PlaceName)
local value = 0
local good = false
&#9;for h = 1, #_G.Games do
&#9;&#9;if _G.Games[h] == PlaceName then
&#9;&#9;&#9;if _G.TimeUntil[h] == 0 then
&#9;&#9;&#9;val = math.random(15 , 30)*_G.Change[h]
&#9;&#9;&#9;value = value + val
&#9;&#9;&#9;good = true
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;if good then
&#9;---normalise value
&#9;value = normalise(value , PlaceName)
&#9;return value
&#9;end
return nil
end

----This function gets new stock values in a really simplistic way currently, will make it depend on recent news soon.
----To do: implement news function
function changestocks(dowa_it)
if dowa_it then message(&quot;_All&quot; , &quot;Stock prices have been updated&quot;) end
local nwmodel = game.Lighting.StocksValues[&quot;0&quot;]:Clone()
local newmodel = nwmodel:GetChildren()
&#9;for z = 1, #newmodel do
&#9;---check for events.
&#9;local event = findevent(newmodel[z].Name)
&#9;&#9;if event then
&#9;&#9;newmodel[z].Value = newmodel[z].Value + event
&#9;&#9;else
&#9;&#9;local rand = math.random(1,10)
&#9;&#9;&#9;if rand &lt;= 3 then
&#9;&#9;&#9;newmodel[z].Value = newmodel[z].Value - math.random(5, 30)  ---up or down 5 to 30
&#9;&#9;&#9;else
&#9;&#9;&#9;newmodel[z].Value = newmodel[z].Value + math.random(5, 30)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
shiftevents()
local update = game.Lighting.StocksValues:GetChildren()
&#9;for q = 1, #update do
&#9;local num = tonumber(update[q].Name) + 1
&#9;update[q].Name = tostring(num)
&#9;end
game.Lighting.StocksValues[&quot;11&quot;]:Remove()
nwmodel.Parent = game.Lighting.StocksValues
if dowa_it then wa_it(1) end  --Giving them a chance to read that the stocks updated
player = game.Players:GetChildren()            ---Finding new net worth values
&#9;for div = 1, #player do
&#9;local DataModel = game.Lighting.StocksDataModels:FindFirstChild(player[div].Name) 
&#9;&#9;if not DataModel then
&#9;&#9;wa_it(1)
&#9;&#9;DataModel = game.Lighting.StocksDataModels:FindFirstChild(player[div].Name)&#9;
&#9;&#9;end
&#9;local currentvalues = game.Lighting.StocksValues[&quot;0&quot;]:GetChildren()
&#9;local networth = 0
&#9;&#9;---Find the amount the stocks in the data model are worth.
&#9;&#9;for q = 1, #currentvalues do
&#9;&#9;networth = networth + (currentvalues[q].Value*DataModel[currentvalues[q].Name].Value)&#9;
&#9;&#9;end
&#9;&#9;if dowa_it then message(player[div].Name, &quot;&quot; ..(networth &gt; (player[div].leaderstats[&quot;Net Worth&quot;].Value - player[div].leaderstats[&quot;Cash on Hand&quot;].Value) and &quot;You gained &quot; or &quot;You lost &quot;).. &quot;&quot; ..tostring(math.abs(networth - (player[div].leaderstats[&quot;Net Worth&quot;].Value - player[div].leaderstats[&quot;Cash on Hand&quot;].Value))).. &quot;$ when the stocks updated.&quot;) end
&#9;player[div].leaderstats[&quot;Net Worth&quot;].Value = networth + player[div].leaderstats[&quot;Cash on Hand&quot;].Value
&#9;end
if dowa_it then wa_it(3) end
end


function rungame()
print(&quot;ROUND BREAK!!!!!!!!!!!!!!!!!&quot;)
&#9;for time = dividendtime, 0, -1 do
&#9;wa_it(1)
&#9;local timemess = math.floor(time + 0.5)
&#9;message(&quot;_All&quot; , &quot;Time until dividends are paid : &quot; ..math.floor(timemess/60).. &quot; minutes, &quot; ..((timemess% 60) &lt; 10  and &quot;0&quot; or &quot;&quot;)..(timemess % 60).. &quot; seconds&quot;)
&#9;end
&#9;paydividends()
&#9;for time = dividendtime, 0, -1 do
&#9;wa_it(1)
&#9;local timemess = math.floor(time + 0.5) 
&#9;message(&quot;_All&quot; , &quot;Time until stock prices change : &quot; ..math.floor(timemess/60).. &quot; minutes, &quot; ..((timemess% 60) &lt; 10  and &quot;0&quot; or &quot;&quot;)..(timemess % 60).. &quot; seconds&quot;)
&#9;end&#9;
changestocks(true)
paydividends()
end

--Generate unique values at the start of each server

for i = 1, 10 do
changestocks(false)
end

while true do
rungame()
end








