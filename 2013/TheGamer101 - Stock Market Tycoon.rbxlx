								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">ElevatorScript</string>
								<ProtectedString name="Source">local deb = false
local location = CFrame.new(483, 7.7, -23)

function teleport(player3 , loc)
&#9;if player3.Character then
&#9;player3.Character.Torso.CFrame = loc
&#9;&#9;if player3.Character.Torso.CFrame ~= loc then
&#9;&#9;wait()
&#9;&#9;teleport(player3 , loc)
&#9;&#9;end
&#9;end
end


function blackout(player2, endtransparency, seconds,steps)
&#9;gui = player2.PlayerGui:FindFirstChild(&quot;Blackout&quot;).GUI
&#9;firsttransparency = gui.BackgroundTransparency
&#9;for i = 1, steps do
&#9;gui.BackgroundTransparency = gui.BackgroundTransparency + (endtransparency-firsttransparency)/steps
&#9;wait(seconds/steps)
&#9;end
end&#9;

function ot(hit)
&#9;if not deb then
&#9;&#9;if hit.Parent:FindFirstChild(&quot;Humanoid&quot;) then
&#9;&#9;&#9;if game.Players:GetPlayerFromCharacter(hit.Parent) then
&#9;&#9;&#9;player = game.Players:GetPlayerFromCharacter(hit.Parent)
&#9;&#9;&#9;deb = true
&#9;&#9;&#9;blackout(player, 0, 1, 50)
&#9;&#9;&#9;teleport(player, location)
&#9;&#9;&#9;blackout(player, 1, 1, 50)
&#9;&#9;&#9;deb = false
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
script.Parent.Touched:connect(ot)

</ProtectedString>
