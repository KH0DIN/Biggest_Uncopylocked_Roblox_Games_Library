			<Item class="Script" referent="RBX5556">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">PositionTest</string>
					<ProtectedString name="Source">local bricks = {}  --table of bricks
local difference = {}  ---table of CFrames&apos;s in relation to the sizebrick

function compare1(val1 , val2)
local retu = 0
&#9;if val1 &gt; val2 then
&#9;---val1 is greater than it
&#9;retu = val1 - val2
&#9;&#9;if retu &lt; 0 then
&#9;&#9;retu = retu*-1
&#9;&#9;end
&#9;else
&#9;---val1 is less than it
&#9;retu = (val2 - val1)*-1
&#9;end
return retu
end

function getdiff1(compare , current)
local x = compare1(current.Position.X , compare.Position.X)
local y = compare1(current.Position.Y , compare.Position.Y)
local z = compare1(current.Position.Z , compare.Position.Z)
local crrame = Vector3.new(x , y ,z) --current.CFrame + 
return crrame
end

function gettables(model1 , original_parent)
local chil = model1:GetChildren()
local returntab1 = {}
local returntab2 = {}
&#9;for g = 1, #chil do
&#9;&#9;if chil[g].ClassName == &quot;Part&quot; or chil[g].ClassName == &quot;WedgePart&quot; then
&#9;&#9;table.insert(returntab1 , chil[g])
&#9;&#9;table.insert(returntab2 , chil[g].Parent)
&#9;&#9;chil[g].Parent = original_parent
&#9;&#9;elseif chil[g].ClassName == &quot;Model&quot; then
&#9;&#9;local tab1 = {}
&#9;&#9;local tab2 = {}
&#9;&#9;tab1 , tab2 = gettables(chil[g] , original_parent)
&#9;&#9;&#9;for x = 1, #tab1 do
&#9;&#9;&#9;table.insert(returntab1 , tab1[x])
&#9;&#9;&#9;table.insert(returntab2 , tab2[x])
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
return returntab1 , returntab2
end

function movemod(model , xval , yval , zval)
print(&quot;Positioning&quot;)
local all = model:GetChildren()
---make the sizebrick and move all the bricks into the outside model
local parts = {}
local originalparents ={}
parts , originalparents = gettables(model , model)
game.Lighting.Scripts.GetBrickForModel:Clone().Parent = model
wait()
local sizebrick = model:FindFirstChild(&quot;SizeBrick&quot;)
local all = model:GetChildren()
yval = sizebrick.Position.Y
&#9;if sizebrick then
&#9;&#9;for g = 1, #all do
&#9;&#9;&#9;if all[g].ClassName == &quot;Part&quot; or all[g].ClassName == &quot;WedgePart&quot; then
&#9;&#9;&#9;table.insert(bricks, all[g])
&#9;&#9;&#9;local getcframe = getdiff1(sizebrick , all[g])
&#9;&#9;&#9;table.insert(difference , getcframe)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;---now move the size brick and set up the model again
&#9;sizebrick.CFrame = CFrame.new(xval, yval , zval)
&#9;&#9;for g = 1, #bricks do
&#9;&#9;local fram1 = CFrame.Angles(bricks[g].CFrame:toEulerAnglesXYZ())
&#9;&#9;bricks[g].CFrame = sizebrick.CFrame + difference[g]
&#9;&#9;bricks[g].CFrame = bricks[g].CFrame*fram1
&#9;&#9;end
&#9;end
---put the parents back
wait(5)
&#9;for g = 1, #parts do
&#9;&#9;parts[g].Parent = originalparents[g]
&#9;end
end


function changed()
&#9;if script.Chang1.Value == true then
&#9;movemod(script.Parent , script.XVal.Value , script.YVal.Value , script.ZVal.Value)
&#9;&#9;if script.Parent.SizeBrick.Position.X ~= script.XVal.Value then
&#9;&#9;wait()
&#9;&#9;movemod(script.Parent , script.XVal.Value , script.YVal.Value , script.ZVal.Value)
&#9;&#9;end
&#9;script:Remove()
&#9;end
end
script.Chang1.Changed:connect(changed)




</ProtectedString>
