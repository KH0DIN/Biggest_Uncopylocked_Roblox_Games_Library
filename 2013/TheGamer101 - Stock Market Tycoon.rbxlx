					<Item class="Script" referent="RBX536">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Sit</string>
							<ProtectedString name="Source">function ot(hit)
&#9;if hit then
&#9;local hum = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;&#9;if hum then
&#9;&#9;local player = game.Players:GetPlayerFromCharacter(hit.Parent)
&#9;&#9;&#9;if player then
&#9;&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId , 119850537)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

local stuff = script.Parent:GetChildren()
&#9;for i =1, #stuff do
&#9;&#9;if stuff[i].ClassName == &quot;Seat&quot; then
&#9;&#9;stuff[i].Touched:connect(ot)
&#9;&#9;end
&#9;end

</ProtectedString>
						</Properties>
