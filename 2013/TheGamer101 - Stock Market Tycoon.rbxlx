			<Item class="Script" referent="RBX5561">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">GetBrickForModel</string>
					<ProtectedString name="Source">function compareheight(brick , type)
local height = 0
&#9;if type == 1 then
&#9;height = brick.Position.X - brick.Size.X/2
&#9;elseif type == 2 then
&#9;height = brick.Position.X + brick.Size.X/2
&#9;elseif type == 3 then
&#9;height = brick.Position.Y - brick.Size.Y/2
&#9;elseif type == 4 then
&#9;height = brick.Position.Y + brick.Size.Y/2
&#9;elseif type == 5 then
&#9;height = brick.Position.Z - brick.Size.Z/2
&#9;elseif type == 6 then
&#9;height = brick.Position.Z + brick.Size.Z/2   ----yay for lots of elseifs :)
&#9;end
return height
end

function comp(value1 , value2 , number)
&#9;if number/2 == math.floor(number/2) then
&#9;&#9;if value1 &gt; value2 then
&#9;&#9;return true
&#9;&#9;end
&#9;else
&#9;&#9;if value2 &gt; value1 then
&#9;&#9;return true
&#9;&#9;end
&#9;end
return false
end

function returnsize(val1ue , val2ue)
local position = (val1ue + val2ue)/2
local size = val1ue - val2ue
&#9;if size &lt; 0 then
&#9;size = size*-1
&#9;end
return position , size
end

mod = script.Parent:GetChildren()
local values = {0 , 0 , 0 , 0 , 0 , 0}  ---low x , high x , low y , high y , low z , high z
&#9;for i = 1 , #mod do
&#9;&#9;if mod[i].ClassName == &quot;Part&quot; or mod[i].ClassName == &quot;WedgePart&quot; then
&#9;&#9;&#9;for h = 1 , #values do
&#9;&#9;&#9;local val1 = compareheight(mod[i] , h)
&#9;&#9;&#9;local trueorfalse = comp(val1 , values[h] , h)
&#9;&#9;&#9;&#9;if trueorfalse == true then
&#9;&#9;&#9;&#9;values[h] = val1
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;if values[h] == 0 then
&#9;&#9;&#9;&#9;&#9;values[h] = val1
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
---make the brick from the 6 values.
&#9;for i =1 , #values do
&#9;print(values[i])
&#9;end
local posx , sizex = returnsize(values[1] , values[2])
local posy , sizey = returnsize(values[3] , values[4])
local posz , sizez = returnsize(values[5] , values[6])
local p = Instance.new(&quot;Part&quot;)
p.Parent = script.Parent
p.Name = &quot;SizeBrick&quot;
p.FormFactor = &quot;Custom&quot;
p.Transparency = 1
p.CanCollide = false
p.Size = Vector3.new(sizex , sizey , sizez)
p.CFrame = CFrame.new(posx , posy , posz)
p.Anchored = true
wait()
script:Destroy()


</ProtectedString>
