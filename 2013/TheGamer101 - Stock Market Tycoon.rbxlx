					<ProtectedString name="Source">-----TheGamer101
local inside1 = false

function updatenews()
&#9;if inside1 == false then
&#9;&#9;for i = 1, #_G.EventHappened do
&#9;&#9;script.Parent.StartFrame[&quot;Event&quot; ..i].Event.Text = _G.EventHappened[i]
&#9;&#9;&#9;if _G.Time[i] == 0 then
&#9;&#9;&#9;script.Parent.StartFrame[&quot;Event&quot; ..i].Time.Text = &quot;Breaking news!&quot;
&#9;&#9;&#9;else
&#9;&#9;&#9;script.Parent.StartFrame[&quot;Event&quot; ..i].Time.Text = _G.Time[i].. &quot; hour&quot; ..(_G.Time[i] == 1 and &quot;&quot; or &quot;s&quot;).. &quot; ago :&quot;&#9;
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
game.Workspace.DataChanged.Changed:connect(updatenews)&#9;
&#9;
function updateinside()
&#9;for i = 1, #_G.InsideHappened do
&#9;script.Parent.StartFrame[&quot;Event&quot; ..i].Event.Text = _G.InsideHappened[i]
&#9;&#9;if _G.Time2[i] == 0 then
&#9;&#9;script.Parent.StartFrame[&quot;Event&quot; ..i].Time.Text = &quot;New tip!&quot;
&#9;&#9;else
&#9;&#9;script.Parent.StartFrame[&quot;Event&quot; ..i].Time.Text = _G.Time2[i].. &quot; hour&quot; ..(_G.Time2[i] == 1 and &quot;&quot; or &quot;s&quot;).. &quot; ago :&quot;&#9;
&#9;&#9;end
&#9;end
end&#9;

for i = 2, 10 do
&#9;newevent = script.Parent.StartFrame.Event1:Clone()
&#9;newevent.Parent = script.Parent.StartFrame
&#9;newevent.Position = UDim2.new(0.225, 0, (0.075 + 0.09*(i - 1)), 0)
&#9;newevent.Name = &quot;Event&quot; ..i
end
local player = script.Parent.Parent.Parent
local openval = false
local deb = false

function datachange1()
&#9;if inside1 then
&#9;updateinside()
&#9;end
end
game.Workspace.DataChanged.Changed:connect(datachange1)&#9;

function insider()
&#9;if inside1 == false then
&#9;inside1 = true
&#9;&#9;if game:GetService(&quot;GamePassService&quot;):PlayerHasPass(player, 119849660) == true then
&#9;&#9;script.Parent.StartFrame.Inside.Text = &quot;Close Inside Information&quot;
&#9;&#9;updateinside()
&#9;&#9;else
&#9;&#9;game:GetService(&quot;MarketplaceService&quot;):PromptPurchase(player, 119849660)
&#9;&#9;end
&#9;else
&#9;inside1 = false
&#9;updatenews()
&#9;script.Parent.StartFrame.Inside.Text = &quot;View Inside Information&quot;
&#9;end
end
script.Parent.StartFrame.Inside.MouseButton1Down:connect(insider)


function open()
&#9;if not deb then
&#9;deb = true
&#9;&#9;if openval then
&#9;&#9;openval = false
&#9;&#9;script.Parent.StartFrame:TweenPosition(UDim2.new(0.150000006, 0, -0.9, 0), 0, 0, 2, true)
&#9;&#9;wait(2)
&#9;&#9;script.Parent.StartFrame.Visible = false
&#9;&#9;script.Parent.OpenNews.Text = &quot;Open news!&quot;
&#9;&#9;deb = false
&#9;&#9;else
&#9;&#9;updatenews()&#9;&#9;
&#9;&#9;openval = true
&#9;&#9;script.Parent.StartFrame.Visible = true
&#9;&#9;script.Parent.StartFrame:TweenPosition(UDim2.new(0.150000006, 0, 0.0610000007, 0), 1, 6, 3, true)
&#9;&#9;script.Parent.OpenNews.Text = &quot;Close news!&quot;
&#9;&#9;deb = false
&#9;&#9;end
&#9;end
end
script.Parent.OpenNews.MouseButton1Down:connect(open)

