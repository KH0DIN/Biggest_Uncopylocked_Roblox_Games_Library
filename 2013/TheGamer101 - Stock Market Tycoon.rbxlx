					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">BuyGui</string>
					<ProtectedString name="Source">---TheGamer101

local player = script.Parent.Parent.Parent

function clearbuttons()
local stuff = script.Parent.StartFrame:GetChildren()
&#9;for g = 1, #stuff do
&#9;&#9;if stuff[g].Name == &quot;ObjectSelect&quot; then
&#9;&#9;stuff[g]:Destroy()
&#9;&#9;end
&#9;end
end

function unlock(model)
local chil = model:GetChildren()
&#9;for i = 1, #chil do
&#9;&#9;if chil[i].ClassName == &quot;Part&quot; or chil[i].ClassName == &quot;WedgePart&quot; then
&#9;&#9;&#9;if chil[i].Name == &quot;BuySphere&quot; then
&#9;&#9;&#9;chil[i]:Destroy()
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;if chil[i]:FindFirstChild(&quot;Transparency1&quot;) then
&#9;&#9;&#9;&#9;chil[i].Transparency = chil[i].Transparency1.Value
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;chil[i].Transparency = 0
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if chil[i]:FindFirstChild(&quot;CanCollide1&quot;) == nil then
&#9;&#9;&#9;&#9;chil[i].CanCollide = true
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif chil[i].ClassName == &quot;Model&quot; then
&#9;&#9;local canunlock = chil[i]:FindFirstChild(&quot;BuySphere&quot;)
&#9;&#9;&#9;if canunlock == nil then&#9;&#9;&#9;
&#9;&#9;&#9;unlock(chil[i])
&#9;&#9;&#9;else
&#9;&#9;&#9;canunlock.Transparency = 0
&#9;&#9;&#9;canunlock.CanCollide = true
&#9;&#9;&#9;canunlock.Sparkles.Enabled = true
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function selectedchanged(value)
&#9;if value then
&#9;&#9;if value.Parent then
&#9;&#9;local guis = script.Parent.StartFrame:GetChildren()
&#9;&#9;&#9;for g = 1, #guis do
&#9;&#9;&#9;&#9;if guis[g].Name == &quot;ObjectSelect&quot; then
&#9;&#9;&#9;&#9;&#9;if guis[g].ObjectValue.Value == value then
&#9;&#9;&#9;&#9;&#9;guis[g].BackgroundColor3 = Color3.new(0 , 1 , 0)
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;guis[g].BackgroundColor3 = Color3.new(1 , 0 , 0)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end&#9;
&#9;&#9;script.Parent.StartFrame.Selected.Text = &quot;Selected : &quot; ..value.Parent.Name
&#9;&#9;script.Parent.StartFrame.Cost.Text = &quot;Cost : &quot; ..value.Price.Value
&#9;&#9;&#9;if player.leaderstats[&quot;Cash on Hand&quot;].Value &gt;= value.Price.Value then
&#9;&#9;&#9;script.Parent.StartFrame.BuyNow.Text = &quot;Buy now!&quot;&#9;
&#9;&#9;&#9;else
&#9;&#9;&#9;script.Parent.StartFrame.BuyNow.Text = &quot;Not enough money&quot;&#9;
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
script.Parent.Selected.Changed:connect(selectedchanged)

function buy()
local selected = script.Parent.Selected.Value
&#9;if selected then
&#9;local price = selected.Price.Value
&#9;&#9;if player.leaderstats[&quot;Cash on Hand&quot;].Value &gt;= price then
&#9;&#9;player.leaderstats[&quot;Cash on Hand&quot;].Value = player.leaderstats[&quot;Cash on Hand&quot;].Value - price
&#9;&#9;player.leaderstats[&quot;Net Worth&quot;].Value = player.leaderstats[&quot;Net Worth&quot;].Value - price
&#9;&#9;script.Parent.StartFrame.Selected.Text = &quot;Selected : None&quot;
&#9;&#9;script.Parent.StartFrame.Cost.Text = &quot;Cost : None&quot;
&#9;&#9;updategui()
&#9;&#9;local model = selected.Parent
&#9;&#9;unlock(model)
&#9;&#9;end
&#9;end
end
script.Parent.StartFrame.BuyNow.MouseButton1Down:connect(buy)

function notindone(table1 , value)
&#9;for k = 1, #table1 do
&#9;&#9;if table1[k] == value then
&#9;&#9;return false 
&#9;&#9;end
&#9;end
return true
end

function updategui()&#9;
local objects = script.Parent.Objects:GetChildren()
&#9;if #objects == 0 then
&#9;script.Parent.StartFrame.Visible = false
&#9;script.Parent.Backing.Visible = false
&#9;else
&#9;script.Parent.StartFrame.Visible = true
&#9;script.Parent.Backing.Visible = true
&#9;local space = 0.7  --- the space of the objects
&#9;local maxbacking = 0.7&#9;
&#9;local sizeeach = 0.1
&#9;&#9;if #objects &gt; 7 then
&#9;&#9;sizeeach = 0.7/#objects
&#9;&#9;end 
&#9;local backing = script.Parent.Backing
&#9;---now check does selected need to change
&#9;local selected = script.Parent.Selected.Value
&#9;&#9;if selected then
&#9;&#9;local good = false
&#9;&#9;&#9;for g = 1, #objects do
&#9;&#9;&#9;&#9;if objects[g].Value == selected then
&#9;&#9;&#9;&#9;good = false
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end&#9;
&#9;&#9;&#9;if good == false then
&#9;&#9;&#9;---isn&apos;t good, change selected to none
&#9;&#9;&#9;script.Parent.StartFrame.Selected.Text = &quot;Selected : None&quot;
&#9;&#9;&#9;script.Parent.StartFrame.Cost.Text = &quot;Cost : None&quot;
&#9;&#9;&#9;script.Parent.StartFrame.BuyNow.Text = &quot;Buy now!&quot;
&#9;&#9;&#9;script.Parent.Selected.Value = nil
&#9;&#9;&#9;end
&#9;&#9;end
&#9;---make each GUI button
&#9;local button = game.Lighting.GuiObjects.ObjectSelect
&#9;clearbuttons()
&#9;local position = 0.3
&#9;local done = {}
&#9;local doneobjects = 0
&#9;&#9;for j = 1, #objects do
&#9;&#9;&#9;if objects[j].ClassName == &quot;ObjectValue&quot; then
&#9;&#9;&#9;&#9;if objects[j].Value then
&#9;&#9;&#9;&#9;&#9;if objects[j].Value.Parent then
&#9;&#9;&#9;&#9;&#9;&#9;if notindone(done , objects[j].Value) then
&#9;&#9;&#9;&#9;&#9;&#9;table.insert(done , objects[j].Value)
&#9;&#9;&#9;&#9;&#9;&#9;local newbutton = button:Clone()
&#9;&#9;&#9;&#9;&#9;&#9;newbutton.Parent = script.Parent.StartFrame
&#9;&#9;&#9;&#9;&#9;&#9;newbutton.Position = UDim2.new(0 , 0 , position , 0)
&#9;&#9;&#9;&#9;&#9;&#9;newbutton.Size = UDim2.new(1 , 0 , sizeeach , 0)
&#9;&#9;&#9;&#9;&#9;&#9;newbutton.Text = objects[j].Value.Parent.Name
&#9;&#9;&#9;&#9;&#9;&#9;newbutton.ObjectValue.Value = objects[j].Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if objects[j].Value == script.Parent.Selected.Value then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;newbutton.BackgroundColor3 = Color3.new(0 , 1 , 0)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;doneobjects = doneobjects + 1
&#9;&#9;&#9;&#9;&#9;&#9;position = position + sizeeach
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;backing.Size = UDim2.new(0.2 ,0 , maxbacking*(0.32 + sizeeach*doneobjects) , 0)
&#9;end
end

function removed()
print(&quot;Child removed from objects&quot;)
updategui()&#9;
end
script.Parent.Objects.ChildRemoved:connect(removed)

function added()
print(&quot;Child Added to objects&quot;)
updategui()&#9;
end
script.Parent.Objects.ChildAdded:connect(added)


