			<Item class="Script" referent="RBX680">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">RealEstateGUI</string>
					<ProtectedString name="Source">---TheGamer101
local sFrame = script.Parent.StartFrame
local CurrentHouse = 1
local ActualHouse = 1
local okay = true
local HouseNames = {&quot;Small House&quot;, &quot;Big Two Story House&quot;, &quot;Mansion&quot;, &quot;Trade Building&quot;}
local givehousenames = {&quot;BungalowObject&quot; , &quot;HouseObject&quot; , &quot;MansionObject&quot;, &quot;TradeBuilding&quot;}
local HouseImages = {&quot;http://www.roblox.com/asset/?id=117842306&quot;, &quot;http://www.roblox.com/asset/?id=117842338&quot;, &quot;http://www.roblox.com/asset/?id=117842375&quot;, &quot;http://www.roblox.com/asset/?id=120124795&quot;}
local HousePrice = {10000, 100000, 500000, 20000000}
local HouseButtons = {script.Parent.StartFrame.House1, script.Parent.StartFrame.House2, script.Parent.StartFrame.House3, script.Parent.StartFrame.House4}
local HouseDetails = {&quot;This house is a small house, it is very basic and doesn&apos;t have much furniture.&quot; , &quot;This house is a much bigger than the bungalow, lots of class.&quot; , &quot;This house is for the super rich, you need to be a very good investor to own this.&quot; , &quot;Want to start your own stock trading company? Be warned, this building is only for the super rich.&quot;}

function UpdateCurrent(n)                                    
local Stats = script.Parent.StartFrame.Stats
script.Parent.StartFrame.Details.Details.Text = HouseDetails[n]
Stats.HouseTitle.Text = &quot;&quot; ..HouseNames[n]
&#9;if n == 1 then
&#9;Stats.Price.Text = &quot;This is the default house&quot;
&#9;else
&#9;Stats.Price.Text = &quot;This house costs &quot; ..tostring(HousePrice[n]).. &quot;$&quot;
&#9;end
sFrame.PictureoHouse.Image = HouseImages[n]
end

function MouseHovered(v, i)
&#9;for l = 1, #HouseButtons do
&#9;HouseButtons[l].TextColor3 = Color3.new(1,1,1)  
&#9;end
&#9;v.TextColor3 = Color3.new(0,1,0)
&#9;CurrentHouse = i
&#9;UpdateCurrent(CurrentHouse)
end

function MouseClicked(v, i)
&#9;for l = 1, #HouseButtons do
&#9;HouseButtons[l].TextColor3 = Color3.new(1,1,1) 
&#9;end
&#9;CurrentHouse = i
&#9;ActualHouse = i
&#9;v.TextColor3 = Color3.new(0,1,0)
&#9;UpdateCurrent(ActualHouse)
end

function MouseLeft()
&#9;for l = 1, #HouseButtons do
&#9;HouseButtons[l].TextColor3 = Color3.new(1,1,1)  
&#9;end
local toupdate = &quot;House&quot; ..ActualHouse
sFrame[toupdate].TextColor3 = Color3.new(0,1,0)
UpdateCurrent(ActualHouse)
end

for i, v in pairs(HouseButtons) do
&#9;v.Text = HouseNames[i]
&#9;v.MouseEnter:connect(function() MouseHovered(v, i) end)
&#9;v.MouseLeave:connect(function() MouseLeft() end)
&#9;v.MouseButton1Down:connect(function() MouseClicked(v, i) end)
end

function buyhouse()
&#9;if okay then
&#9;okay = false
&#9;local button = script.Parent.StartFrame.BuyHouse
&#9;local player = script.Parent.Parent.Parent
&#9;local tycoonname = player.Name.. &quot;Tycoon&quot;
&#9;local tycoonnum = player.TycoonNumber.Value
&#9;&#9;if ActualHouse &gt; tycoonnum then 
&#9;&#9;&#9;if player.leaderstats[&quot;Cash on Hand&quot;].Value &gt;= HousePrice[ActualHouse] then
&#9;&#9;&#9;local message = _G.GiveHouse(player , givehousenames[ActualHouse])
&#9;&#9;&#9;&#9;if message == 2 then
&#9;&#9;&#9;&#9;player.TycoonNumber.Value = ActualHouse
&#9;&#9;&#9;&#9;player.leaderstats[&quot;Cash on Hand&quot;].Value = player.leaderstats[&quot;Cash on Hand&quot;].Value - HousePrice[ActualHouse]&#9;
&#9;&#9;&#9;&#9;player.leaderstats[&quot;Net Worth&quot;].Value = player.leaderstats[&quot;Net Worth&quot;].Value - HousePrice[ActualHouse]
&#9;&#9;&#9;&#9;pcall(function() player:SaveNumber(&quot;CashonHand&quot;, player.leaderstats[&quot;Cash on Hand&quot;].Value) end) 
&#9;&#9;&#9;&#9;button.Text = &quot;You have just bought a &quot; ..HouseNames[ActualHouse]
&#9;&#9;&#9;&#9;elseif message == 1 then
&#9;&#9;&#9;&#9;button.Text = &quot;There are no available plots of land!&quot;
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;button.Text = &quot;You already have that house!&quot;
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;wait(2)
&#9;&#9;&#9;button.Text = &quot;Buy this house!&quot;
&#9;&#9;&#9;else
&#9;&#9;&#9;button.Text = &quot;You cannot afford this house&quot;
&#9;&#9;&#9;wait(2)
&#9;&#9;&#9;button.Text = &quot;Buy this house!&quot;
&#9;&#9;&#9;end
&#9;&#9;elseif ActualHouse == tycoonnum then
&#9;&#9;button.Text = &quot;You already have a that house.&quot;
&#9;&#9;wait(2)
&#9;&#9;button.Text = &quot;Buy this house!&quot;
&#9;&#9;else
&#9;&#9;button.Text = &quot;You already have a better house.&quot;
&#9;&#9;wait(2)
&#9;&#9;button.Text = &quot;Buy this house!&quot;
&#9;&#9;end
&#9;okay = true
&#9;end
end&#9;
script.Parent.StartFrame.BuyHouse.MouseButton1Down:connect(buyhouse)

openval = false
deb = false

function open()
&#9;if not deb then
&#9;deb = true
&#9;&#9;if openval then
&#9;&#9;openval = false
&#9;&#9;script.Parent.StartFrame:TweenPosition(UDim2.new(0.150000006, 0, -0.7, 0), 0, 0, 2, true)
&#9;&#9;wait(2)
&#9;&#9;script.Parent.StartFrame.Visible = false
&#9;&#9;script.Parent.OpenRealEstate.Text = &quot;Buy house!&quot;
&#9;&#9;deb = false
&#9;&#9;else
&#9;&#9;openval = true
&#9;&#9;script.Parent.StartFrame.Visible = true
&#9;&#9;script.Parent.StartFrame:TweenPosition(UDim2.new(0.150000006, 0, 0.200000003, 0), 1, 6, 2, true)
&#9;&#9;script.Parent.OpenRealEstate.Text = &quot;Close GUI!&quot;
&#9;&#9;deb = false
&#9;&#9;end
&#9;end
end
script.Parent.OpenRealEstate.MouseButton1Down:connect(open)



</ProtectedString>
