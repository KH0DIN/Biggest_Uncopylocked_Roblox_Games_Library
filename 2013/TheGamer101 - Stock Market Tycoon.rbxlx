			<Item class="Script" referent="RBX616">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">StocksGUI</string>
					<ProtectedString name="Source">-----TheGamer101

dollarsvalues = {56, 174 , 137 , 191 ,123 , 69 , 57 , 94 , 76 , 154 , 100}
---Values will be 1 hour apart game time, real time 2 minutes.

lastin = 0
buyframe = script.Parent.BuyStocks
Frame = script.Parent.Frame
sellfram = script.Parent.SellStocks
fullclose = false

xaxismin = 0.1
xaxismax = 0.95
yaxismin = 0.095
yaxismax = 0.845

mindollars = 1000000
maxdollars = 0



sFrame = script.Parent.StartFrame
showing = false 
CurrentGame = 1
ActualGame = 1


function drawline(startpos, endpos)
local increment = 100
local xdistance = endpos.X.Scale - startpos.X.Scale
local ydistance = endpos.Y.Scale - startpos.Y.Scale
&#9;for q = 0, increment do --100 increments seems to work well..
&#9;local plotter = Frame.DataPlotter:Clone()
&#9;plotter.Size = UDim2.new(math.abs(xdistance/100) ,0 , math.abs(ydistance/100) , 0)
&#9;plotter.Position = UDim2.new((startpos.X.Scale + q*(xdistance/increment)), 0, (startpos.Y.Scale + q*(ydistance/increment)), 0)
&#9;plotter.Name = &quot;DrawLine&quot;
&#9;plotter.Visible = true
&#9;plotter.Parent = Frame
&#9;end
end



function drawgraph(number)
Frame.Title.Text = &quot;Stock performance of &quot; ..GameNames[number]
dollarsvalues = {}    ---Clear values which were previously in use....
mindollars = 1000000
maxdollars = 0
stocksvals = game.Lighting.StocksValues:GetChildren()
&#9;for p = 0, (#stocksvals - 1) do
&#9;local model = game.Lighting.StocksValues[tostring(p)]
&#9;local name = GameNames[number]
&#9;table.insert(dollarsvalues, 1, model[name].Value)     ---Inserted at one because the graph counts from 10 hours ago to now
&#9;end
&#9;for i = 1, #dollarsvalues do
&#9;&#9;if dollarsvalues[i] &lt; mindollars then
&#9;&#9;mindollars = dollarsvalues[i]
&#9;&#9;end
&#9;&#9;if dollarsvalues[i] &gt; maxdollars then
&#9;&#9;maxdollars = dollarsvalues[i]
&#9;&#9;end
&#9;end
&#9;if math.fmod(maxdollars, 10) ~= 0 then
&#9;maxdollars = (maxdollars - math.fmod(maxdollars, 10)) + 10
&#9;end
&#9;if math.fmod(mindollars, 10) ~= 0 then
&#9;mindollars = mindollars - math.fmod(mindollars, 10)
&#9;end
---Range of values found
---Divide up y axis...
---Increments of 10
local increments = math.floor((maxdollars - mindollars)/10)
local valtoadd = ((yaxismax-yaxismin)/increments)
&#9;for x = 0, increments do
&#9;local ylabel = Frame.Yaxislabel:Clone()
&#9;ylabel.Name = &quot;YLABEL&quot; ..tostring(x)
&#9;ylabel.Position = UDim2.new(ylabel.Position.X.Scale, 0 , yaxismin + (x*valtoadd) , 0)
&#9;ylabel.Text = tostring(maxdollars - x*10).. &quot;$&quot; 
&#9;ylabel.Visible = true
&#9;ylabel.Parent = Frame
&#9;&#9;if x == increments then                  ----Stops the X-axis and this element blending
&#9;&#9;ylabel.YaxisIndicator.Size = UDim2.new(0.5, 0, 9.99999975e-005, 0)
&#9;&#9;end
&#9;end
----Y-axis divided, now do X-axis
local valtoaddx = ((xaxismax-xaxismin)/#dollarsvalues)
&#9;for x = 0, (#dollarsvalues - 1) do
&#9;local xlabel = Frame.Xaxislabel:Clone()
&#9;xlabel.Name = &quot;XLABEL&quot; ..tostring(x)
&#9;xlabel.Position = UDim2.new((xaxismin + (x*valtoaddx) - 0.025), 0 , xlabel.Position.Y.Scale, 0)
&#9;xlabel.Text = tostring(#dollarsvalues -(x +1)).. &quot;hr&quot; ..(#dollarsvalues -(x +1) == 1  and &quot;&quot; or &quot;s&quot;).. &quot; ago&quot; 
&#9;xlabel.Visible = true
&#9;xlabel.Parent = Frame
&#9;end
---X-axis done, now draw the line...
&#9;for z = 2, #dollarsvalues do 
&#9;local val1 = (maxdollars - dollarsvalues[z])/10           ---These are seperate for convienience 
&#9;local val2 = ((maxdollars - dollarsvalues[z - 1]))/10
&#9;local currentpoint = UDim2.new(xaxismin + (valtoaddx*(z - 1)), 0 , (yaxismin + (valtoadd*val1)) + 0.055, 0)  ---.055 is the offset from the bottum of the graph
&#9;local lastpoint = UDim2.new(xaxismin + (valtoaddx*(z - 2)), 0 , (yaxismin + (valtoadd*val2)) + 0.055, 0)
&#9;drawline(lastpoint, currentpoint)
&#9;end
end



GameNames = {&quot;Sword Fighting Tournament&quot;, &quot;Base Wars&quot;, &quot;Call of Robloxia&quot;, &quot;Catalog Heaven&quot;, &quot;Galleons&quot;, &quot;Hide and Seek&quot;, &quot;Jet Wars : Advanced Battle&quot;, &quot;Paintball&quot; , &quot;Six Flags&quot; , &quot;Sword Fights on the Heights IV&quot; , &quot;The Underground Wars&quot; , &quot;Welcome to Roblox Building&quot;}
GameImages = {&quot;http://www.roblox.com/asset/?id=96398494&quot;, &quot;http://www.roblox.com/asset/?id=96456889&quot;, &quot;http://www.roblox.com/asset/?id=96456911&quot;, &quot;http://www.roblox.com/asset/?id=96456932&quot;,&quot;http://www.roblox.com/asset/?id=96456961&quot;, &quot;http://www.roblox.com/asset/?id=96456981&quot;, &quot;http://www.roblox.com/asset/?id=96457021&quot;, &quot;http://www.roblox.com/asset/?id=96457036&quot; , &quot;http://www.roblox.com/asset/?id=96457104&quot; , &quot;http://www.roblox.com/asset/?id=96457218&quot; , &quot;http://www.roblox.com/asset/?id=96458172&quot; , &quot;http://www.roblox.com/asset/?id=96457340&quot;}
GameStockPrice = {100, 120, 120, 30, 50, 70, 90, 100, 200, 130, 150, 60}
GameButtons = {script.Parent.StartFrame.Game1, script.Parent.StartFrame.Game2, script.Parent.StartFrame.Game3, script.Parent.StartFrame.Game4, script.Parent.StartFrame.Game5, script.Parent.StartFrame.Game6, script.Parent.StartFrame.Game7, script.Parent.StartFrame.Game8, script.Parent.StartFrame.Game9, script.Parent.StartFrame.Game10, script.Parent.StartFrame.Game11, script.Parent.StartFrame.Game12}

function findintable(val, table)
&#9;for b = 1, #table do
&#9;&#9;if table[b] == val then
&#9;&#9;return true
&#9;&#9;end
&#9;end
return false
end



function UpdateCurrent(n)
script.Parent.StartFrame.Owned.Active = false
script.Parent.StartFrame.Owned.Text = &quot;None Owned&quot;
script.Parent.StartFrame.Owned.TextColor3 = Color3.new(1, 0, 0)                                        
local datamodel = game.Lighting.StocksDataModels:FindFirstChild(script.Parent.Parent.Parent.Name)
&#9;if datamodel ~= nil then
&#9;local game = GameNames[n]
&#9;&#9;if datamodel[game].Value &gt; 0 then
&#9;&#9;script.Parent.StartFrame.Owned.Active = true
&#9;&#9;script.Parent.StartFrame.Owned.Text = &quot;Sell Stock&quot;
&#9;&#9;script.Parent.StartFrame.Owned.TextColor3 = Color3.new(0, 1, 0)
&#9;&#9;end
&#9;end
Stats = script.Parent.StartFrame.Stats
Stats.TGameTitle.Text = &quot;&quot; ..GameNames[n]
local model = game.Lighting.StocksValues[&quot;0&quot;]
local name = GameNames[n]
Stats.CurrentPrice.Text = &quot;Stock price: &quot; ..tostring(model[name].Value).. &quot;$&quot;
sFrame.PictureoGame.Image = GameImages[n]
end

function MouseHovered(v, i)
&#9;for l = 1, #GameButtons do
&#9;GameButtons[l].TextColor3 = Color3.new(1,1,1)  
&#9;end
&#9;v.TextColor3 = Color3.new(0,1,0)
&#9;CurrentGame = i
&#9;UpdateCurrent(CurrentGame)
end

function MouseClicked(v, i)
&#9;for l = 1, #GameButtons do
&#9;GameButtons[l].TextColor3 = Color3.new(1,1,1)   
&#9;end
&#9;CurrentGame = i
&#9;ActualGame = i
&#9;v.TextColor3 = Color3.new(0,1,0)
&#9;UpdateCurrent(ActualGame)
end

function MouseLeft()
&#9;for l = 1, #GameButtons do
&#9;GameButtons[l].TextColor3 = Color3.new(1,1,1)   
&#9;end
&#9;local toupdate = &quot;Game&quot; ..ActualGame
&#9;sFrame[toupdate].TextColor3 = Color3.new(0,1,0)
&#9;UpdateCurrent(ActualGame)
end


for i, v in pairs(GameButtons) do
&#9;v.Text = GameNames[i]
&#9;v.MouseEnter:connect(function() MouseHovered(v, i) end)
&#9;v.MouseLeave:connect(function() MouseLeft() end)
&#9;v.MouseButton1Down:connect(function() MouseClicked(v, i) end)
end



function showgraph()
if showing then return end
showing = true
Frame.Title.Text = &quot;Stock performance of &quot; ..GameNames[ActualGame]
---Get rid of the current frame.
&#9;for m = 0, 1, 0.02 do
&#9;sFrame.Position = sFrame.Position - UDim2.new(0,0,0.02,0)
&#9;wait()
&#9;end
&#9;for m = 0, 1, 0.02 do
&#9;Frame.Position = Frame.Position - UDim2.new(0.02,0,0,0)
&#9;wait()
&#9;end
drawgraph(ActualGame)
end
sFrame.Options.ViewGraph.MouseButton1Down:connect(showgraph)

keepongraph = {&quot;CloseGraph&quot;, &quot;DataPlotter&quot; , &quot;Title&quot; , &quot;TitleBorder&quot; , &quot;XAxis&quot; , &quot;Xaxislabel&quot; , &quot;YAxis&quot; , &quot;Yaxislabel&quot;}

function findintable(val, table)
&#9;for b = 1, #table do
&#9;&#9;if table[b] == val then
&#9;&#9;return true
&#9;&#9;end
&#9;end
return false
end

function closegraph()
if not showing then return end
---Get rid of the current frame.
&#9;for m = 0, 1, 0.02 do
&#9;Frame.Position = Frame.Position + UDim2.new(0.02,0,0,0)
&#9;wait()
&#9;end&#9;
&#9;Frame.Position = UDim2.new(1.14999998, 0, 0.200000003)
&#9;if not fullclose then
&#9;--put back the startframe
&#9;&#9;for m = 0, 1, 0.02 do
&#9;&#9;sFrame.Position = sFrame.Position + UDim2.new(0,0,0.02,0)
&#9;&#9;wait()
&#9;&#9;end
&#9;end
---Clear the frame containing the graph
objects = Frame:GetChildren()
&#9;for x = 1, #objects do
&#9;&#9;if findintable(objects[x].Name, keepongraph) == false then
&#9;&#9;objects[x]:Remove()
&#9;&#9;end
&#9;end
showing = false
end
Frame.CloseGraph.MouseButton1Down:connect(closegraph)

function clearbuy()
buyframe.AmountHere.Text = &quot;Type the amount here&quot;
buyframe.Visible = false
buyframe.Active = false
sFrame.Visible = true
sFrame.Active = true
end
buyframe.Cancel.MouseButton1Down:connect(clearbuy)

function buystocks()
local player = script.Parent.Parent.Parent
&#9;if tonumber(buyframe.AmountHere.Text) ~= nil then   ---Easy way of checking did they only type in numbers
&#9;&#9;if player.leaderstats[&quot;Cash on Hand&quot;].Value &gt;= tonumber(buyframe.AmountHere.Text) and tonumber(buyframe.AmountHere.Text) &gt; 0 then
&#9;&#9;local model = game.Lighting.StocksValues[&quot;0&quot;]
&#9;&#9;local name = GameNames[ActualGame]
&#9;&#9;local amtobuy = tonumber(buyframe.AmountHere.Text) - math.fmod(tonumber(buyframe.AmountHere.Text), model[name].Value)
&#9;&#9;local stocknumber = amtobuy/model[name].Value
&#9;&#9;local playermodel = game.Lighting.StocksDataModels:FindFirstChild(player.Name)
&#9;&#9;&#9;if playermodel ~= nil then
&#9;&#9;&#9;playermodel[name].Value = playermodel[name].Value + stocknumber
&#9;&#9;&#9;end
&#9;&#9;player.leaderstats[&quot;Cash on Hand&quot;].Value = player.leaderstats[&quot;Cash on Hand&quot;].Value + math.fmod(tonumber(buyframe.AmountHere.Text), model[name].Value)
&#9;&#9;player.leaderstats[&quot;Cash on Hand&quot;].Value = player.leaderstats[&quot;Cash on Hand&quot;].Value - tonumber(buyframe.AmountHere.Text)&#9;
&#9;&#9;pcall(function() player:SaveNumber(&quot;CashonHand&quot;, player.leaderstats[&quot;Cash on Hand&quot;].Value) end) 
&#9;&#9;pcall(function() player:SaveInstance(player.Name, game.Lighting.StocksDataModels[player.Name]) end) 
&#9;&#9;buyframe.Cannot.Visible = true
&#9;&#9;buyframe.Cannot.Text = &quot;You have just bought &quot; ..tostring(tonumber(buyframe.AmountHere.Text) - math.fmod(tonumber(buyframe.AmountHere.Text), model[name].Value)).. &quot;$ worth of stock&quot;
&#9;&#9;wait(2)
&#9;&#9;buyframe.Cannot.Visible = false&#9;
&#9;&#9;buyframe.Cannot.Text = &quot;You cannot afford that many stocks&quot;
&#9;&#9;clearbuy()
&#9;&#9;else
&#9;&#9;buyframe.Cannot.Visible = true
&#9;&#9;wait(2)
&#9;&#9;buyframe.Cannot.Visible = false&#9;
&#9;&#9;end
&#9;else 
&#9;buyframe.Cannot.Visible = true
&#9;buyframe.Cannot.Text = &quot;Please enter a number&quot;
&#9;wait(2)
&#9;buyframe.Cannot.Visible = false&#9;
&#9;buyframe.Cannot.Text = &quot;You cannot afford that many stocks&quot;
&#9;end
end
buyframe.Buy.MouseButton1Down:connect(buystocks)


function showbuy()
sFrame.Visible = false
sFrame.Active = false
buyframe.Title.Text = &quot;Buy Stocks in &quot; ..GameNames[ActualGame]
buyframe.Visible = true
buyframe.Active = true
end
sFrame.Options.BuyStock.MouseButton1Down:connect(showbuy)




function showsell()
&#9;if sFrame.Owned.TextColor3 == Color3.new(0,1,0) then
&#9;sellframe = script.Parent.SellStocks
&#9;sFrame.Visible = false
&#9;sFrame.Active = false
&#9;sellframe.Title.Text = &quot;Selling stocks in &quot; ..GameNames[ActualGame]
&#9;local datamodel = game.Lighting.StocksDataModels:FindFirstChild(script.Parent.Parent.Parent.Name)
&#9;&#9;if datamodel ~= nil then
&#9;&#9;local gamen = GameNames[ActualGame]
&#9;&#9;&#9;if datamodel[gamen].Value &gt; 0 then
&#9;&#9;&#9;local model = game.Lighting.StocksValues[&quot;0&quot;]
&#9;&#9;&#9;local name = GameNames[ActualGame]
&#9;&#9;&#9;script.Parent.SellStocks.Owned.Text = &quot;You currently own &quot; ..tostring(datamodel[gamen].Value*model[name].Value).. &quot;$ worth&quot;  
&#9;&#9;&#9;sellframe.StocksValue.Value = datamodel[gamen].Value*model[name].Value
&#9;&#9;&#9;end
&#9;&#9;end
&#9;sellframe.Visible = true
&#9;sellframe.Active = true
&#9;end
end
sFrame.Owned.MouseButton1Down:connect(showsell)

function clearsell()
local sellframe = script.Parent.SellStocks
sellframe.AmountHere.Text = &quot;Type the amount here&quot;
sellframe.Visible = false
sellframe.Active = false
sFrame.Visible = true
sFrame.Active = true
end
script.Parent.SellStocks.Cancel.MouseButton1Down:connect(clearsell)


function sellstocks()
local sellframe = script.Parent.SellStocks
local player = script.Parent.Parent.Parent
&#9;if tonumber(sellframe.AmountHere.Text) ~= nil then   ---Easy way of checking did they only type in numbers
&#9;&#9;if sellframe.StocksValue.Value &gt;= tonumber(sellframe.AmountHere.Text) and tonumber(sellframe.AmountHere.Text) &gt; 0 then
&#9;&#9;local model = game.Lighting.StocksValues[&quot;0&quot;]
&#9;&#9;local name = GameNames[ActualGame]
&#9;&#9;local amtosell = tonumber(sellframe.AmountHere.Text) - math.fmod(tonumber(sellframe.AmountHere.Text), model[name].Value)
&#9;&#9;local stocknumber = amtosell/model[name].Value
&#9;&#9;local playermodel = game.Lighting.StocksDataModels:FindFirstChild(player.Name)
&#9;&#9;--&#9;if playermodel ~= nil then
&#9;&#9;&#9;playermodel[name].Value = playermodel[name].Value - stocknumber
&#9;&#9;--&#9;end
&#9;&#9;player.leaderstats[&quot;Cash on Hand&quot;].Value = player.leaderstats[&quot;Cash on Hand&quot;].Value - math.fmod(tonumber(sellframe.AmountHere.Text), model[name].Value)
&#9;&#9;player.leaderstats[&quot;Cash on Hand&quot;].Value = player.leaderstats[&quot;Cash on Hand&quot;].Value + tonumber(sellframe.AmountHere.Text)&#9;
&#9;&#9;local model = game.Lighting.StocksValues[&quot;0&quot;]
&#9;&#9;sellframe.StocksValue.Value = playermodel[name].Value*model[name].Value        ---this should get a better count of leftover assets...
&#9;&#9;script.Parent.SellStocks.Owned.Text = &quot;You currently own &quot; ..tostring(sellframe.StocksValue.Value).. &quot;$ worth&quot;  
&#9;&#9;pcall(function() player:SaveNumber(&quot;CashonHand&quot;, player.leaderstats[&quot;Cash on Hand&quot;].Value) end) 
&#9;&#9;pcall(function() player:SaveInstance(player.Name, game.Lighting.StocksDataModels[player.Name]) end) 
&#9;&#9;sellframe.Cannot.Visible = true
&#9;&#9;sellframe.Cannot.Text = &quot;You have just sold &quot; ..tostring(tonumber(sellframe.AmountHere.Text)&#9;- math.fmod(tonumber(sellframe.AmountHere.Text), model[name].Value)).. &quot;$ of stock&quot;
&#9;&#9;wait(2)
&#9;&#9;sellframe.Cannot.Visible = false&#9;
&#9;&#9;sellframe.Cannot.Text = &quot;You do not have that many stocks&quot;
&#9;&#9;clearsell()
&#9;&#9;else
&#9;&#9;sellframe.Cannot.Visible = true
&#9;&#9;wait(2)
&#9;&#9;sellframe.Cannot.Visible = false&#9;
&#9;&#9;end
&#9;else 
&#9;sellframe.Cannot.Visible = true
&#9;sellframe.Cannot.Text = &quot;Please enter a number&quot;
&#9;wait(2)
&#9;sellframe.Cannot.Visible = false&#9;
&#9;sellframe.Cannot.Text = &quot;You do not have that many stocks&quot;
&#9;end
end
script.Parent.SellStocks.Sell.MouseButton1Down:connect(sellstocks)

---Open and close button is for testing purposes, you will have to go to the stock market to buy stocks later on
openval = false
deb = false

function open()
&#9;if not deb then
&#9;deb = true
&#9;&#9;if openval then
&#9;&#9;openval = false
&#9;&#9;clearbuy()
&#9;&#9;clearsell()
&#9;&#9;fullclose = true
&#9;&#9;closegraph()
&#9;&#9;fullclose = false
&#9;&#9;script.Parent.StartFrame:TweenPosition(UDim2.new(0.150000006, 0, -0.7, 0), 0, 0, 2, true)
&#9;&#9;wait(2)
&#9;&#9;script.Parent.StartFrame.Visible = false
&#9;&#9;script.Parent.OpenStocks.Text = &quot;Buy stocks!&quot;
&#9;&#9;deb = false
&#9;&#9;else
&#9;&#9;openval = true
&#9;&#9;script.Parent.StartFrame.Visible = true
&#9;&#9;script.Parent.StartFrame:TweenPosition(UDim2.new(0.150000006, 0, 0.200000003, 0), 1, 6, 2, true)
&#9;&#9;script.Parent.OpenStocks.Text = &quot;Close stocks!&quot;
&#9;&#9;deb = false
&#9;&#9;end
&#9;end
end
script.Parent.OpenStocks.MouseButton1Down:connect(open)










