			</Item>
			<Item class="Script" referent="RBX5562">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">MakeInvis</string>
					<ProtectedString name="Source">function makeinvis(model, depth)
local chil = model:GetChildren()
&#9;for x = 1, #chil do
&#9;&#9;if chil[x].ClassName == &quot;Part&quot; or chil[x].ClassName == &quot;WedgePart&quot; then
&#9;&#9;&#9;if chil[x].Name == &quot;BuySphere&quot; then
&#9;&#9;&#9;&#9;if depth &gt; 3 then
&#9;&#9;&#9;&#9;chil[x].Transparency = 1
&#9;&#9;&#9;&#9;chil[x].CanCollide = false
&#9;&#9;&#9;&#9;chil[x].Sparkles.Enabled = false
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;if chil[x].Transparency ~= 0 then
&#9;&#9;&#9;&#9;local int1 = Instance.new(&quot;NumberValue&quot;)
&#9;&#9;&#9;&#9;int1.Name = &quot;Transparency1&quot;
&#9;&#9;&#9;&#9;int1.Value = chil[x].Transparency
&#9;&#9;&#9;&#9;int1.Parent = chil[x]
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if chil[x].CanCollide == false then
&#9;&#9;&#9;&#9;local int2 = Instance.new(&quot;IntValue&quot;)
&#9;&#9;&#9;&#9;int2.Name = &quot;CanCollide1&quot;
&#9;&#9;&#9;&#9;int2.Value = 0
&#9;&#9;&#9;&#9;int2.Parent = chil[x]
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;chil[x].Transparency = 1
&#9;&#9;&#9;chil[x].CanCollide = false
&#9;&#9;&#9;end
&#9;&#9;elseif chil[x].ClassName == &quot;Model&quot; then
&#9;&#9;makeinvis(chil[x] , depth + 1)
&#9;&#9;end
&#9;end
end
makeinvis(script.Parent , 1)

</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX5563">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">MakeVis</string>
					<ProtectedString name="Source">function makevis(model)
local chil = model:GetChildren()
&#9;for x = 1, #chil do
&#9;&#9;if chil[x].ClassName == &quot;Part&quot; or chil[x].ClassName == &quot;WedgePart&quot; then
&#9;&#9;&#9;if chil[x].Name == &quot;BuySphere&quot; then
&#9;&#9;&#9;--chil[x]:Destroy()
&#9;&#9;&#9;else
&#9;&#9;&#9;chil[x].Transparency = 0
&#9;&#9;&#9;chil[x].CanCollide = true
&#9;&#9;&#9;end
&#9;&#9;elseif chil[x].ClassName == &quot;Model&quot; then
&#9;&#9;makevis(chil[x])
&#9;&#9;end
&#9;end
end
makevis(script.Parent)

