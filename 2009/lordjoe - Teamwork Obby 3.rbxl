				<Item class="Script" referent="RBX2748">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">--Basically checks if the toucher of the button is a player, then adds money to that player.

--Uberubert
--This script is free to use for anyone

local ting = 0 --debouncer

function onTouched(hit)
&#9;print(&quot;Touched&quot;)
&#9;if ting == 0 then --debounce check
&#9;ting = 1 --activate debounce
&#9;check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) --Find the human that touched the button

&#9;if check ~= nil then --If a human is found, then
&#9;&#9;print(&quot;IsHuman&quot;)
&#9;&#9;local user = game.Players:GetPlayerFromCharacter(hit.Parent) --get player from touching human
&#9;&#9;local stats = user:findFirstChild(&quot;leaderstats&quot;) --Find moneyholder

&#9;&#9;if stats ~= nil then --If moneyholder exists then
&#9;&#9;&#9;print(&quot;StatsExsist&quot;)
&#9;&#9;&#9;local cash = stats:findFirstChild(&quot;Points&quot;) --Get money
&#9;&#9;&#9;local debounce = user:findFirstChild(&quot;Free&quot;)
&#9;&#9;&#9;if debounce.Value == 0 then
&#9;&#9;&#9;&#9;print(&quot;DebounceWorked&quot;)
&#9;&#9;&#9;&#9;debounce.Value = debounce.Value + 1
&#9;&#9;&#9;&#9;cash.Value = cash.Value + 100 --increase amount of money by the number displayed here (500)
&#9;&#9;&#9;&#9;print(&quot;PointsGiven&quot;)
&#9;&#9;&#9;&#9;wait(5) --wait-time before button works again
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end

&#9;ting = 0 --remove debounce
&#9;end

end

script.Parent.Touched:connect(onTouched)
</ProtectedString>
					</Properties>
				</Item>
