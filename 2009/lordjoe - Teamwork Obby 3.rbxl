				<Item class="Script" referent="RBX861">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local set = false
local msg = script.Parent.Parent
function onTouched(hit)
&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;local human = hit.Parent.Name
&#9;if humanoid~=nil and set == false then
&#9;&#9;set = true
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency - 1
&#9;&#9;msg.Name = human .. &quot; is doomed in 3...&quot;
&#9;&#9;wait(1)
&#9;&#9;msg.Name = human .. &quot; is doomed in 2...&quot;
&#9;&#9;wait(1)
&#9;&#9;msg.Name = human .. &quot; is doomed in 1...&quot;
&#9;&#9;wait(1)
&#9;&#9;humanoid.Health = 0
&#9;&#9;msg.Name = human .. &quot; is terminated. Resting...&quot;
&#9;&#9;wait(3)
&#9;&#9;msg.Name = &quot;Resting&quot;
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency + 1
&#9;&#9;set = false
&#9;end
end
script.Parent.Touched:connect(onTouched)</ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
