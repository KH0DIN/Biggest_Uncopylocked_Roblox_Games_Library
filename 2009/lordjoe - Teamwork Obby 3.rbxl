							<ProtectedString name="Source">local set = false

function onTouched(hit)
&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if humanoid~=nil and set == false then
&#9;&#9;set = true
&#9;&#9;script.Parent.BrickColor = BrickColor.new(23)
&#9;&#9;script.Parent.Parent.Door1.Transparency = 0
&#9;&#9;script.Parent.Parent.Door1.CanCollide = true
&#9;&#9;wait(3)
&#9;&#9;script.Parent.Parent.Door1.CanCollide = false
&#9;&#9;script.Parent.Parent.Door1.Transparency = 0.5
&#9;&#9;script.Parent.BrickColor = BrickColor.new(37)
&#9;&#9;set = false
&#9;end
end
script.Parent.Touched:connect(onTouched)</ProtectedString>
