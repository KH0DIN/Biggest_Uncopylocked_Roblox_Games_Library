							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local door = script.Parent.Parent.Door

function clicked()
if script.Value.Value == 0 and door.Ready.Value == 0 then
print(&quot;Opened&quot;)
script.Value.Value = 1
door.CanCollide = false
door.Transparency = 0.8
wait(5)
door.Transparency = 0
door.CanCollide = true
script.Value.Value = 0
else
print(&quot;Locked.&quot;)
end
end


script.Parent.ClickDetector.MouseClick:connect(clicked)</ProtectedString>
