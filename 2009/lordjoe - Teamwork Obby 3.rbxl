		<Item class="Script" referent="RBX3906">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">UpdateMaker</string>
				<ProtectedString name="Source">h = Instance.new(&quot;Hint&quot;)
h.Parent = game.Workspace

while true do
h.Text = &quot;.:|Teamwork Obby 3|:. - V3 - Admin Doors are up and running.&quot;
wait(3)
h.Text = &quot;.:|Teamwork Obby 3|:. - V3 - 5 new badges added!&quot;
wait(3)
h.Text = &quot;.:|Teamwork Obby 3|:. - V3 - Points Badges fixed.&quot;
wait(3)
h.Text = &quot;.:|Teamwork Obby 3|:. - V3 - Timed Regen made for all buttons!&quot;
wait(3)
end
</ProtectedString>
			</Properties>
		</Item>
