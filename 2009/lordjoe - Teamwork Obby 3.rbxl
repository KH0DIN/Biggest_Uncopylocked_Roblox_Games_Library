					<ProtectedString name="Source">while true do
wait(0.01)
if script.Parent.Locko.Value ~= 0 then
script.Parent.Locko.Value = script.Parent.Locko.Value - 1
script.Parent.Name = &quot;Door Lock-out Timer [&quot; .. script.Parent.Locko.Value .. &quot;]&quot;
wait(1)
end
end
