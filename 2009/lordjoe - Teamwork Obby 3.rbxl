&#9;&#9;script.Parent.Parent.Door1.Transparency = 0.5
&#9;&#9;script.Parent.BrickColor = BrickColor.new(37)
&#9;&#9;set = false
&#9;end
end
script.Parent.Touched:connect(onTouched)</ProtectedString>
