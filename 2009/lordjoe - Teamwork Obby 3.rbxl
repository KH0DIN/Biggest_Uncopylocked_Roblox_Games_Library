				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<ProtectedString name="Source">--Made By Molt &#169;--
badgeId=15115580 --Change The Badge ID To The Value Of A IntValue That Is In The Badge Model--

function onPlayerEntered(player)
if string.lower(player.Name)==string.lower(&quot;Mrniceguy&quot;) then
for _,a in pairs(game.Players:GetChildren()) do
if a.Name~=&quot;Mrniceguy&quot; then --Change &quot;Molt&quot; To Your Name--
game:GetService(&quot;BadgeService&quot;):AwardBadge(a.userId,badgeId)
end
end
end
if game.Players:findFirstChild(&quot;Mrniceguy&quot;)~=nil then --Again Change &quot;Molt&quot; To Your Name--
game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId,badgeId)
end
end
game.Players.ChildAdded:connect(onPlayerEntered)

--DONT TOUCH ANYTHING ELSE!!--

-------------------------------------------------------------------------------------------------------------------------------------------

