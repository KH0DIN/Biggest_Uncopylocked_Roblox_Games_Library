			<Item class="Script" referent="RBX3521">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Beasty&apos;sTimedRegen</string>
					<ProtectedString name="Source">object = script.Parent 
if (object ~= nil) and (object ~= game.Workspace) then 
model = object 

backup = model:clone()  
waitTime = 300
wait(math.random(0, waitTime)) 
while true do 
wait(waitTime) 

model:remove() 

wait(.05) 

model = backup:clone() 
print(&quot;regened&quot;)
model.Parent = game.Workspace 
model:makeJoints() 
message.Parent = nil 
end 
end 
</ProtectedString>
