		<Item class="Script" referent="RBX57">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Leaderboard</string>
				<ProtectedString name="Source">--OBS : NOT MY SCRIPT ENTIRELY!
--This is a modified version of a script I got from the &quot;all models&quot; search. I don&apos;t know who the author is.

--Basically it adds a cash-holder to each player.
--The money is stored in &quot;game.Players.--Playername--.Leaderstats.Cash&quot;

print(&quot;Cash Stuffs running!&quot;)

function onPlayerEntered(newPlayer)
&#9;wait(.5)
&#9;local stats = Instance.new(&quot;IntValue&quot;)
&#9;stats.Name = &quot;leaderstats&quot;

&#9;local check = Instance.new(&quot;IntValue&quot;)
&#9;check.Name = &quot;Free&quot;

&#9;local cash = Instance.new(&quot;IntValue&quot;)
&#9;cash.Name = &quot;Points&quot;
&#9;cash.Value = 0 --This sets the amount of money every player starts with

&#9;cash.Parent = stats
&#9;
&#9;stats.Parent = newPlayer

&#9;check.Parent = newPlayer

if (player.stats.money.Value ==100) then 
local p = game.Players:GetPlayerFromCharacter(script.Parent.Parent) 
if (p ~= nil) then 
print(&quot;Awarding BadgeID: &quot; ..script.Parent.BadgeID.Value .. &quot; to UserID: &quot; .. p.userId) 
local b = game:GetService(&quot;BadgeService&quot;) 
b:AwardBadge(p.userId, script.Parent.BadgeID.Value) 
end

end

end

game.Players.ChildAdded:connect(onPlayerEntered)
</ProtectedString>
			</Properties>
