			<Item class="Script" referent="RBX1305">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">local set = false

function onTouched(hit)
&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if humanoid~=nil and set == false then
&#9;&#9;set = true
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency - 0.1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency - 0.1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency - 0.1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency - 0.1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency - 0.1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency - 0.1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency - 0.1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency - 0.1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency - 0.1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = 0
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency + 0.1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency + 0.1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency + 0.1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency + 0.1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency + 0.1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency + 0.1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency + 0.1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency + 0.1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency + 0.1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = 1
&#9;&#9;set = false
&#9;end
end
script.Parent.Touched:connect(onTouched)</ProtectedString>
				</Properties>
			</Item>
