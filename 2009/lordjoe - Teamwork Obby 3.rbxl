wait(.01)
a.Transparency = 1
a.CanCollide = false
wait(5)
a.CanCollide = true
a.Transparency = 0.9
wait(.01)
a.Transparency = 0.8
wait(.01)
a.Transparency = 0.7
wait(.01)
a.Transparency = 0.6
wait(.01)
a.Transparency = 0.5
wait(.01)
a.Transparency = 0.4
wait(.01)
a.Transparency = 0.3
wait(.01)
a.Transparency = 0.2
wait(.01)
a.Transparency = 0.1
wait(.01)
a.Transparency = 0
wait(5)
end </ProtectedString>
