							<string name="Name">Script</string>
							<ProtectedString name="Source">local set = false

function onTouched(hit)
&#9;local person = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;local ready = script.Parent.Ready
&#9;if person ~= nil and set == false and ready.Value == 1 then
&#9;&#9;set = true
&#9;&#9;print(&quot;Worked!&quot;)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency + .1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency + .1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency + .1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency + .1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency + .1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency + .1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency - .1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency - .1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency - .1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency - .1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency - .1
&#9;&#9;wait(.01)
&#9;&#9;script.Parent.Transparency = script.Parent.Transparency - .1
&#9;&#9;wait(.01)
&#9;&#9;local message = Instance.new(&quot;Message&quot;)
&#9;&#9;message.Text = &quot;Going down?&quot;
&#9;&#9;message.Parent = game.Players:playerFromCharacter(hit.Parent)
&#9;&#9;wait(3)
&#9;&#9;message:remove()
&#9;&#9;script.Parent.Parent.Floor.Transparency = .5
&#9;&#9;script.Parent.Parent.Floor.CanCollide = false
&#9;&#9;wait(2)
&#9;&#9;script.Parent.Parent.Floor.Transparency = 0
&#9;&#9;script.Parent.Parent.Floor.CanCollide = true
&#9;&#9;script.Parent.CanCollide = false
&#9;&#9;wait(1)
&#9;&#9;ready.Value = 0
&#9;&#9;set = false
&#9;&#9;else
&#9;&#9;print(&quot;Script failed...&quot;)
&#9;end
end
script.Parent.Touched:connect(onTouched)
