if player ~= 0 then
for i = 1,#player do
if player[i].Character ~= nil then
local ff = Instance.new(&quot;ForceField&quot;)
ff.Parent = player[i].Character
end end end end

if string.sub(msg,1,5) == &quot;unff/&quot; then
