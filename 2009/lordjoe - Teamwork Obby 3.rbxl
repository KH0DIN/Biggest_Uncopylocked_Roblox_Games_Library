			<Item class="Script" referent="RBX1937">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">BadgeScript</string>
					<ProtectedString name="Source">BadgeId=&quot;17234690&quot; --inside the &quot;&quot; put the BadgeId of ur badge which is located in its giver ^_^
permission={&quot;Player&quot;} --gives permission to go throu with/without the badge ^_^
on=false
door=script.Parent
print(&quot;Jazy5552 BadgeDoor script Loaded!&quot;)

function open()
door.CanCollide=false
for i=0,1,0.1 do
wait(0.05)
door.Transparency=i
end end
function close()
for i=1,0,-0.1 do
wait(0.05)
door.Transparency=i
end door.CanCollide=true end
function checkpermission(name)
&#9;for i=1,#permission do
&#9;if permission[i]==name then return true
&#9;end end
return false end

function checkdoor(hit)
if hit==nil or hit.Parent==nil then return end
print(&quot;Door Hit&quot;)
local h=hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
if h==nil then return end
if on then return end
on=true
print(&quot;Human&quot;)
&#9;if checkpermission(h.Parent.Name) then
print(&quot;Passed&quot;)
&#9;open()
&#9;wait(0.6)
&#9;close()
&#9;elseif game:GetService(&quot;BadgeService&quot;):UserHasBadge(game.Players:FindFirstChild(h.Parent.Name).userId,BadgeId)~=false then
print(&quot;Passed Badge&quot;)
&#9;open()
&#9;wait(0.6)
&#9;close()
&#9;else h.Sit=true h.Parent.Torso.Velocity=h.Parent.Torso.CFrame:inverse().lookVector*60 --haha my own system of push back ^_^ pushs in oppisite dirrection of ur torso ^_^
&#9;end
wait(1)
on=false
end

script.Parent.Touched:connect(checkdoor)</ProtectedString>
				</Properties>
