		<Item class="Tool" referent="RBX169">
			<Properties>
				<bool name="Enabled">true</bool>
				<CoordinateFrame name="Grip">
					<X>0.300000012</X>
					<Y>0</Y>
					<Z>0</Z>
					<R00>0.217036337</R00>
					<R01>0</R01>
					<R02>0.976163507</R02>
					<R10>-0</R10>
					<R11>1</R11>
					<R12>-0</R12>
					<R20>-0.976163507</R20>
					<R21>0</R21>
					<R22>0.217036337</R22>
				</CoordinateFrame>
				<string name="Name">poop Cake</string>
