				<Item class="Script" referent="RBX3591">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function onTouched(hit)

local clone = script.Parent.Parent.Morph.Mesh:Clone()
clone.Parent = hit.Parent.Torso
hit.Parent.Torso.BrickColor = BrickColor.new(&quot;Earth orange&quot;)
hit.Parent:findFirstChild(&quot;Left Arm&quot;).Transparency = 1
hit.Parent:findFirstChild(&quot;Left Leg&quot;).Transparency = 1
hit.Parent:findFirstChild(&quot;Right Arm&quot;).Transparency = 1
hit.Parent:findFirstChild(&quot;Right Leg&quot;).Transparency = 1
hit.Parent.Head.Transparency = 1

end

script.Parent.touched:connect(onTouched)</ProtectedString>
						<bool name="archivable">true</bool>
