								<double name="Value">50</double>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
						<Item class="NumberValue" referent="RBX398">
							<Properties>
								<string name="Name">Roll</string>
								<double name="Value">4</double>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
						<Item class="NumberValue" referent="RBX399">
							<Properties>
								<string name="Name">Pitch</string>
								<double name="Value">3</double>
								<bool name="archivable">true</bool>
							</Properties>
