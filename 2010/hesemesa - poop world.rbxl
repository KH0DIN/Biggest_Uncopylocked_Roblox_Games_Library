function strRandom(len)
	str = &quot;&quot;
	char = {&apos;a&apos;, &apos;b&apos;, &apos;c&apos;, &apos;d&apos;, &apos;e&apos;}
	for i = 1, len do
		str = str..char[math.random(1, 5)]
	end
	return str
end

if script:FindFirstChild(&quot;Value&quot;) then
