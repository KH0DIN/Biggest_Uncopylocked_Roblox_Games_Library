							<ProtectedString name="Source">function Add(obj)
if obj.C1 ~= nil then
obj.C1 = CFrame.new(0, 1.2,-0.3) * CFrame.fromEulerAnglesXYZ(math.rad(-90),0,0)
print(obj.C1)
end
end
