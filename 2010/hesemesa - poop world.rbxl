				<Item class="Script" referent="RBX4883">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">MasterScript</string>
						<ProtectedString name="Source">engine = script.Parent
Plane = engine.Parent
motor = Plane.Motor
switch = Plane.Switch

bv = engine.BodyVelocity
bg = engine.BodyGyro
bg.cframe = engine.CFrame
click = Plane.ClickDetector

Click_Con = nil
Flying = false

Pitch = 3.5 --Change this value to how fast you want the plane to go up/down.
Roll = 3.5 --Change this value to how fast you want the plane to roll/turn.
Speed = 90 --Change this value to how fast you want the plane to fly.

bg.maxTorque = Vector3.new(0,0,0)
bv.maxForce = Vector3.new(0,0,0)

Click_Con = click.MouseClick:connect(function()
	if Flying == false then
		Flying = true
		switch.BrickColor = BrickColor.new(&quot;Bright green&quot;)
		bg.maxTorque = Vector3.new(3e+005,3e+005,3e+005)
		bv.maxForce = Vector3.new(math.huge,math.huge,math.huge)
		bg.cframe = engine.CFrame
	else
		Flying = false
		switch.BrickColor = BrickColor.new(&quot;Bright red&quot;)
		bg.maxTorque = Vector3.new(0,0,0)
		bv.maxForce = Vector3.new(0,0,0)
		bg.cframe = engine.CFrame
	end
end)

while true do
wait()
if Flying == true then
	bv.velocity = engine.CFrame.lookVector * Speed
	bg.cframe = bg.cframe * CFrame.fromEulerAnglesXYZ((math.rad(Pitch * -motor.Throttle)),0,(math.rad(Roll *-motor.Steer)))
	end
end
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
