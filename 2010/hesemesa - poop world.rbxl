				<Item class="Script" referent="RBX295">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LolHole</string>
						<ProtectedString name="Source">print(&quot;Hole script by turdulator&quot;)
function GetCamera(Part)
Camera=nil
p=game.Workspace:GetChildren()
for i=1, #p do
if p[i].className==&quot;Camera&quot; then
if p[i].CameraSubject==Part then
Camera=p[i]
break
end
end
end
return Camera
end
function Fall(CPlayer)
CPlayer.Torso.CFrame=script.Parent.CFrame+Vector3.new(0,3,0)
CPlayer.Torso.Anchored=true
Cam=GetCamera(CPlayer.Humanoid)
if Cam~=nil then
Cam.CameraType=&quot;Fixed&quot;
end
repeat
CPlayer.Torso.CFrame=CPlayer.Torso.CFrame+Vector3.new(0,-1,0)
CPlayer.Head.CFrame=CPlayer.Head.CFrame+Vector3.new(0,-1,0)
wait()
until CPlayer.Head.Position.y+2&lt;script.Parent.Position.y
wait(2)
Shoot(CPlayer)
end
function Shoot(CPlayer)
CPlayer.Torso.Anchored=false
CPlayer.Torso.CFrame=script.Parent.CFrame+Vector3.new(0,0,0)
p = Instance.new(&quot;BodyVelocity&quot;)
p.maxForce=Vector3.new(math.huge,math.huge,math.huge)
p.velocity = Vector3.new(math.random(-30,30),120,math.random(-30,30))
p.Parent=CPlayer.Torso
g=Instance.new(&quot;BodyGyro&quot;)
g.cframe=g.cframe*CFrame.fromEulerAnglesXYZ(0,0,math.pi/3)
g.Parent=CPlayer.Torso
so=script.OMGGGGG:clone()
so.Parent=CPlayer.Head
so:Play()
game:GetService(&quot;Debris&quot;):AddItem(p,.2)
game:GetService(&quot;Debris&quot;):AddItem(g,1)
s=script.DIE:clone()
s.Disabled=false
s.Parent=CPlayer
end
debounced=true
function Activate(hit)
if hit.Parent==nil then return end
if not debounced then return end
debounced=false
h=hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
if h~=nil then
if h.Health&gt;0 then
wait(.2)
s=script.FellIn:clone()
s.Parent=hit.Parent.Torso
s:Play()
Fall(hit.Parent)
end
end
wait(5)
debounced=true
end
con=script.Parent.Touched:connect(Activate)
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="Script" referent="RBX296">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">DIE</string>
							<ProtectedString name="Source">wait(.2)
function LOL()
script.Parent:BreakJoints()
s=script.Parent:GetChildren()
for i=1, #s do
if s[i].className==&quot;Part&quot; then
s[i].Velocity = Vector3.new(s[i].Velocity.x,-s[i].Velocity.y*2,s[i].Velocity.z)
end
end
script:Remove()
end
script.Parent.Torso.Touched:connect(LOL)
script.Parent.Head.Touched:connect(LOL)
script.Parent[&quot;Left Leg&quot;].Touched:connect(LOL)
script.Parent[&quot;Right Leg&quot;].Touched:connect(LOL)
script.Parent[&quot;Left Arm&quot;].Touched:connect(LOL)
script.Parent[&quot;Right Arm&quot;].Touched:connect(LOL)</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
