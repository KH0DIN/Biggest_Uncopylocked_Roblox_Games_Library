&#9;&#9;&#9;&#9;newmesh.BodyPart = part.LeftLeg.BodyPart
&#9;&#9;&#9;&#9;newmesh.MeshId = part.LeftLeg.MeshId
&#9;&#9;&#9;&#9;newmesh.Name = part.LeftLeg.Name
&#9;&#9;&#9;&#9;newmesh.OverlayTextureId = part.LeftLeg.OverlayTextureId
&#9;&#9;&#9;&#9;newmesh.Parent = char
&#9;&#9;end
&#9;&#9;if frame.Colors.Parts.Value == &quot;rightleg&quot; then
&#9;&#9;&#9;&#9;local newmesh = Instance.new(&quot;CharacterMesh&quot;)
&#9;&#9;&#9;&#9;newmesh.BaseTextureId = part.RightLeg.BaseTextureId
&#9;&#9;&#9;&#9;newmesh.BodyPart = part.RightLeg.BodyPart
