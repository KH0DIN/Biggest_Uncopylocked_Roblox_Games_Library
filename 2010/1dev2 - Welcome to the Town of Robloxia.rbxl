		<Item class="Script" referent="RBX276">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">VipEnter(disabled)</string>
				<ProtectedString name="Source">BadgeID = 48543606 --Change to the Badges ID 
TShirtID = &quot;http://www.roblox.com/asset/?id=27197573&quot; --Change to the VIP T-Shirt&apos;s Asset Link
VIPN = &quot;IsaVIP&quot; -- The name of the VIP value

game.Players.PlayerAdded:connect(function(p) 
&#9;if (p.Character ~= nil) then
&#9;&#9;char = p.Character
&#9;&#9;if (char.Torso:findFirstChild(&quot;roblox&quot;) ~= nil) then
&#9;&#9;&#9;if (char.Torso.roblox.Texture == TShirdID) then
&#9;&#9;&#9;&#9;if game:GetService(&quot;BadgeService&quot;):UserHasBadge(p.userId,BadgeID) then
&#9;&#9;&#9;&#9;&#9;vip = Instance.new(&quot;BoolValue&quot;)
&#9;&#9;&#9;&#9;&#9;vip.Name = VIPN
&#9;&#9;&#9;&#9;&#9;vip.Parent = p
&#9;&#9;&#9;&#9;&#9;vip.Value = true&#9;
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId,BadgeID) &#9;
&#9;&#9;&#9;&#9;&#9;vip = Instance.new(&quot;BoolValue&quot;)
&#9;&#9;&#9;&#9;&#9;vip.Name = VIPN
&#9;&#9;&#9;&#9;&#9;vip.Parent = p
&#9;&#9;&#9;&#9;&#9;vip.Value = true
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end) 
</ProtectedString>
			</Properties>
		</Item>
