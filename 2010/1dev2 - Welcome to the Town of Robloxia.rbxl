				<Item class="Sound" referent="RBX13329">
					<Properties>
						<bool name="Looped">false</bool>
						<string name="Name">Fire</string>
						<float name="Pitch">1.5</float>
						<bool name="PlayOnRemove">false</bool>
						<Content name="SoundId"><url>http://www.roblox.com/asset/?id=2760979</url></Content>
						<float name="Volume">0.100000001</float>
