function Vampire()
&#9;local head = char.Head
&#9;local characterparts = char:GetChildren()
&#9;for x = 1, #characterparts do
&#9;&#9;if characterparts[x].className == &quot;Shirt&quot; then
&#9;&#9;&#9;characterparts[x]:remove()
&#9;&#9;end
&#9;&#9;if characterparts[x].className == &quot;Pants&quot; then
&#9;&#9;&#9;characterparts[x]:remove()
&#9;&#9;end
&#9;&#9;if characterparts[x].className == &quot;Part&quot; then
&#9;&#9;&#9;characterparts[x].BrickColor = BrickColor.new(1028)
&#9;&#9;end
&#9;end
&#9;local newshirt = Instance.new(&quot;Shirt&quot;)
&#9;newshirt.ShirtTemplate = script.VampireShirt.ShirtTemplate
&#9;newshirt.Parent = char
&#9;local newpants = Instance.new(&quot;Pants&quot;)
&#9;newpants.PantsTemplate = script.VampirePants.PantsTemplate
&#9;newpants.Parent = char
&#9;local t = game:GetService(&quot;InsertService&quot;):LoadAsset(16722419) -- putting on vampire face
&#9;t.Parent = head
&#9;local model = head.Model
&#9;local modelparts = model:GetChildren()
&#9;for b = 1, #modelparts do
&#9;&#9;if modelparts[b].className == &quot;Decal&quot; then
&#9;&#9;&#9;char.Head.face.Texture = modelparts[b].Texture
&#9;&#9;&#9;local headparts = head:GetChildren()
&#9;&#9;&#9;for x = 1, #headparts do
&#9;&#9;&#9;&#9;if headparts[x].Name == &quot;Model&quot; then
&#9;&#9;&#9;&#9;&#9;headparts[x]:remove()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;script:findFirstChild(&quot;Fly2&quot;):clone().Parent = player.Backpack
end

