function AlbinoBat()
&#9;script:findFirstChild(&quot;Fly3&quot;):clone().Parent = player.Backpack
&#9;local message = Instance.new(&quot;Message&quot;)
&#9;message.Parent = player
&#9;message.Text = &quot;You have an albino bat tool&quot;
&#9;wait(3)
&#9;message.Text = &quot;at the bottom of your screen.&quot;
&#9;wait(3)
&#9;message:remove()
end

function Frankenstein()
&#9;if char:findFirstChild(&quot;Isamorph&quot;) == nil then
