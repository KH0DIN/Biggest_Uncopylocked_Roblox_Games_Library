			<Item class="Script" referent="RBX13203">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ToolScript</string>
					<ProtectedString name="Source">script.Parent = script.Parent.Parent.Parent

function Tools()

local ot = script.Parent.Backpack:GetChildren()

for i=1, # ot do
if ot[i].Name == &quot;Give $5&quot; or ot[i].Name == &quot;Fly&quot; or ot[i].Name == &quot;Parachute&quot; or ot[i].Name == &quot;Grocery Bag&quot; or ot[i].Name == &quot;Laptop&quot; or ot[i].Name == &quot;Book&quot; or ot[i].Name == &quot;Pencil&quot; or ot[i].Name == &quot;Pencil&amp;Paper&quot; or ot[i].Name == &quot;Umbrella&quot; or ot[i].Name == &quot;Coffee Cup&quot; then
else
ot[i]:Remove()
end
end

if script.Parent.TeamColor == BrickColor.new(&quot;Bright blue&quot;) then
local t = game.Lighting.Pistol:Clone()
t.Parent = script.Parent.Backpack
end

if script.Parent.TeamColor == BrickColor.new(&quot;Really black&quot;) then
local t = game.Lighting.Pistol:Clone()
t.Parent = script.Parent.Backpack
end

if script.Parent.TeamColor == BrickColor.new(&quot;White&quot;) then
local t = game.Lighting.Otoscope:Clone()
t.Parent = script.Parent.Backpack
end

if script.Parent.TeamColor == BrickColor.new(&quot;Bright red&quot;) then
local t = game.Lighting[&quot;Fire Extinguisher&quot;]:Clone()
t.Parent = script.Parent.Backpack
end

if script.Parent.TeamColor == BrickColor.new(&quot;Light orange&quot;) then
local t = game.Lighting.Basketball:Clone()
t.Parent = script.Parent.Backpack
end

if script.Parent.TeamColor == BrickColor.new(&quot;Brown&quot;) then
for i=1, # ot do
ot[i]:Remove()
end
end

end

script.Parent.Changed:connect(Tools)
</ProtectedString>
				</Properties>
			</Item>
			<Item class="Frame" referent="RBX13204">
				<Properties>
					<bool name="Active">false</bool>
					<Color3 name="BackgroundColor3">4278190080</Color3>
					<float name="BackgroundTransparency">0</float>
					<Color3 name="BorderColor3">4278190080</Color3>
					<int name="BorderSizePixel">1</int>
					<bool name="ClipsDescendants">false</bool>
					<bool name="Draggable">false</bool>
					<string name="Name">Background</string>
					<UDim2 name="Position">
						<XS>0</XS>
						<XO>0</XO>
						<YS>0</YS>
						<YO>0</YO>
					</UDim2>
					<UDim2 name="Size">
						<XS>1</XS>
						<XO>0</XO>
						<YS>1</YS>
						<YO>0</YO>
					</UDim2>
					<token name="SizeConstraint">0</token>
					<token name="Style">0</token>
					<bool name="Visible">true</bool>
					<int name="ZIndex">1</int>
				</Properties>
				<Item class="LocalScript" referent="RBX13205">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Test</string>
						<ProtectedString name="Source">local CurCam = game.Workspace.CurrentCamera
local NewCam = Instance.new(&quot;Camera&quot;)
local x = -.6 -- around (-0-)
local y = .08 -- up/down
local z = 2 -- zoom out


function fade()
repeat
wait(.01)
script.Parent.BackgroundTransparency = script.Parent.BackgroundTransparency + .05
script.Parent.Welcome.TextTransparency = script.Parent.Welcome.TextTransparency - .05
NewCam.CoordinateFrame = NewCam.CoordinateFrame * CFrame.new(x,y,z)
until script.Parent.BackgroundTransparency &gt;= 1
end


function unfade()
repeat
wait(.01)
script.Parent.BackgroundTransparency = script.Parent.BackgroundTransparency - .05
script.Parent.Welcome.TextTransparency = script.Parent.Welcome.TextTransparency + .05
NewCam.CoordinateFrame = NewCam.CoordinateFrame * CFrame.new(x,y,z)
until script.Parent.BackgroundTransparency &lt;= 0
end


CurCam.Parent = game.Lighting
NewCam.Parent = game.Workspace
NewCam.CameraSubject = workspace.CamSub
NewCam.CoordinateFrame = CFrame.new(-100,30,0)
NewCam.Focus = workspace.CamSub.CFrame

script.Parent.Loading.Visible = true
wait(1)
script.Parent.Loading.Visible = false
wait(1)

fade()

NewCam.CoordinateFrame = NewCam.CoordinateFrame * CFrame.new(x,y,z)
wait(.01)
NewCam.CoordinateFrame = NewCam.CoordinateFrame * CFrame.new(x,y,z)
wait(.01)
NewCam.CoordinateFrame = NewCam.CoordinateFrame * CFrame.new(x,y,z)
wait(.01)
