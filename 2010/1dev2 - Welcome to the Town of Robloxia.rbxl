function Elf()
&#9;if char:findFirstChild(&quot;IsaMorph&quot;) == nil then
&#9;&#9;local head = char.Head
&#9;&#9;local torso = char.Torso
&#9;&#9;local hat = Instance.new(&quot;Part&quot;) -------------------EAR1 CREATED
&#9;&#9;hat.BrickColor = BrickColor.new(26)
&#9;&#9;hat.Parent = char
&#9;&#9;hat.Position = torso.Position
&#9;&#9;hat.Name = &quot;Hat&quot;
&#9;&#9;hat.formFactor = &quot;Plate&quot;
&#9;&#9;hat.Size = Vector3.new(2, 0.4, 3)
&#9;&#9;local mesh1 = Instance.new(&quot;SpecialMesh&quot;) ----------EAR1 MESH CREATED
&#9;&#9;mesh1.MeshType = &quot;FileMesh&quot;
&#9;&#9;mesh1.MeshId = &quot;http://www.roblox.com/asset/?id=19326037&quot;
&#9;&#9;mesh1.TextureId = &quot;http://www.roblox.com/asset/?id=19326021&quot;
&#9;&#9;mesh1.Scale = Vector3.new(1.05, 1.05, 1.05) 
&#9;&#9;mesh1.Parent = hat
&#9;&#9;local w1 = Instance.new(&quot;Weld&quot;)
&#9;&#9;w1.Parent = torso
&#9;&#9;w1.Part0 = w1.Parent
&#9;&#9;w1.Part1 = hat
&#9;&#9;w1.C1 = CFrame.fromEulerAnglesXYZ(0,0,0) +Vector3.new(0,-2.7,-0.05) 
&#9;&#9;local marker = Instance.new(&quot;StringValue&quot;)
&#9;&#9;marker.Parent = char
&#9;&#9;marker.Name = &quot;IsaMorph&quot;
&#9;&#9;local characterparts = char:getChildren() 
&#9;&#9;for i=1,#characterparts do 
&#9;&#9;&#9;if characterparts[i].className == &quot;CharacterMesh&quot; then
&#9;&#9;&#9;&#9;characterparts[i]:remove()
&#9;&#9;&#9;end
&#9;&#9;&#9;if characterparts[i].className == &quot;Part&quot; then 
&#9;&#9;&#9;&#9;characterparts[i].Locked = true 
&#9;&#9;&#9;&#9;characterparts[i].TopSurface = &quot;Smooth&quot;
&#9;&#9;&#9;&#9;characterparts[i].BottomSurface = &quot;Smooth&quot;
&#9;&#9;&#9;end 
&#9;&#9;&#9;if characterparts[i].className == &quot;Hat&quot; then 
&#9;&#9;&#9;&#9;characterparts[i]:remove()
&#9;&#9;&#9;end 
&#9;&#9;end 
&#9;&#9;local torsomesh = Instance.new(&quot;CharacterMesh&quot;)
&#9;&#9;torsomesh.MeshId = 41794594
&#9;&#9;torsomesh.BodyPart = &quot;Torso&quot;
&#9;&#9;torsomesh.Parent = char
&#9;&#9;torsomesh.OverlayTextureId = 41794780
&#9;&#9;local leftarmmesh = Instance.new(&quot;CharacterMesh&quot;)
&#9;&#9;leftarmmesh.MeshId = 41794495
&#9;&#9;leftarmmesh.BodyPart = &quot;LeftArm&quot;
&#9;&#9;leftarmmesh.Parent = char
&#9;&#9;leftarmmesh.OverlayTextureId = 41794780
&#9;&#9;local rightarmmesh = Instance.new(&quot;CharacterMesh&quot;)
&#9;&#9;rightarmmesh.MeshId = 41794664
&#9;&#9;rightarmmesh.BodyPart = &quot;RightArm&quot;
&#9;&#9;rightarmmesh.Parent = char
&#9;&#9;rightarmmesh.OverlayTextureId = 41794780
&#9;&#9;local leftlegmesh = Instance.new(&quot;CharacterMesh&quot;)
&#9;&#9;leftlegmesh.MeshId = 41794561
&#9;&#9;leftlegmesh.BodyPart = &quot;LeftLeg&quot;
&#9;&#9;leftlegmesh.Parent = char
&#9;&#9;leftlegmesh.OverlayTextureId = 41794780
&#9;&#9;local rightlegmesh = Instance.new(&quot;CharacterMesh&quot;)
