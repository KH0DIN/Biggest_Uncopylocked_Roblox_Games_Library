							<string name="Name">Script</string>
							<ProtectedString name="Source">debounce = false
permission = {&quot;1dev2&quot;, &quot;Playrobot&quot;,&quot;SK8RDEVAN&quot;,&quot;1dev3&quot;,&quot;VvvGarrettvvV&quot;,&quot;films&quot;,&quot;TheScrambledEgg&quot;,&quot;Loupgarou182&quot;,&quot;jaryt23&quot;,&quot;Player&quot;} -- put your name here
local texture = &quot;http://www.roblox.com/asset/?id=27197573&quot;  -- put your shirt&apos;s ID number minus 1 here.
local Door = script.Parent

function checkOkToLetIn(name) 
&#9;for i = 1,#permission do 
&#9;&#9;if (string.upper(name) == string.upper(permission[i])) then return true end 
&#9;end 
&#9;return false 
end 

function onTouched(hit)
&#9;if hit.Parent == nil then return end
&#9;if (hit.Parent:findFirstChild(&quot;Humanoid&quot;) == nil) then return end
&#9;local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;) 
&#9;local char = hit.Parent
&#9;local player = game.Players:GetPlayerFromCharacter(hit.Parent)
&#9;if (human ~= nil) and debounce == false then
&#9;&#9;debounce = true
&#9;&#9;if checkOkToLetIn(char.Name) then 
&#9;&#9;&#9;Door.CanCollide = false
&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;Door.CanCollide = false
&#9;&#9;return end

&#9;&#9;if (char.Torso.roblox.Texture == nil) then
&#9;&#9;&#9;hit.Parent.Humanoid.Health = 0
&#9;&#9;return end
&#9;&#9;if (char.Torso.roblox.Texture ~= nil) then
&#9;&#9;&#9;if char.Torso.roblox.Texture == texture then
&#9;&#9;&#9;&#9;Door.CanCollide = false
&#9;&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;&#9;Door.CanCollide = false
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;hit.Parent.Humanoid.Health = 0
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end 
&#9;wait(5)
&#9;debounce = false
end 



script.Parent.Touched:connect(onTouched)
</ProtectedString>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX7436">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">price = script.Parent.Parent.Price.Value
local debounce = true
function onTouched(part)
local h = part.Parent:FindFirstChild(&quot;Humanoid&quot;)
if game.Players[h.Parent.Name].Value.Value &lt; price then return end
if debounce == true then
debounce = false
game.Players[h.Parent.Name].Value.Value = game.Players[h.Parent.Name].Value.Value - price
a = game.Lighting[script.Parent.Parent.Product.Value]:Clone()
a.Parent = game.Players[h.Parent.Name].Backpack
wait(4)
debounce = true
end
end
script.Parent.Touched:connect(onTouched)
</ProtectedString>
