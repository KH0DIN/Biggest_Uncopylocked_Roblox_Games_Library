									<Properties>
										<bool name="Disabled">false</bool>
										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">Fly Script</string>
										<ProtectedString name="Source">local hold = false 
local u = 40 
local add = 5 
local mode = &quot;Off&quot; 
local char = script.Parent.Parent.Parent.Character

function onSelected(mouse) 
&#9;hint = Instance.new(&quot;Hint&quot;) 
&#9;hint.Parent = script.Parent.Parent.Parent 
&#9;hint.Name = &quot;Modes&quot; 
&#9;hint.Text = &quot;User: &quot;..script.Parent.Parent.Parent.Name..&quot;|Speed: &quot;..u..&quot;|AddValue: &quot;..add..&quot;|Hover: &quot;..mode 
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end) 
&#9;mouse.Button1Up:connect(function() onButton1Up(mouse) end) 
&#9;mouse.KeyDown:connect(onKeyDown) 
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot; 
end 

script.Parent.Selected:connect(onSelected) 

function onDeselected(mouse) 
&#9;wait() 
&#9;script.Parent.Parent.Parent:findFirstChild(&quot;Modes&quot;):remove() 
end 

script.Parent.Deselected:connect(onDeselected) 

function onButton1Down(mouse) 
&#9;hold = true 
&#9;p = Instance.new(&quot;Part&quot;) 
&#9;p.Parent = char
&#9;p.Locked = true 
&#9;p.TopSurface = 0 
&#9;p.BottomSurface = 0 
&#9;p.CanCollide = false 
&#9;p.Transparency = 1 
&#9;p.formFactor = 0 
&#9;p.Size = Vector3.new(3,1,3) 

&#9;w = Instance.new(&quot;Weld&quot;) 
&#9;w.Parent = char.Torso 
&#9;w.Name = &quot;Board&quot; 
&#9;w.Part0 = w.Parent 
&#9;w.Part1 = p 
&#9;w.C0 = CFrame.new(0,1.5,0) * CFrame.fromEulerAnglesXYZ(math.pi / 2,0,0) 

&#9;bg = Instance.new(&quot;BodyGyro&quot;) 
&#9;bg.Parent = p 
&#9;bg.maxTorque = Vector3.new(999999999999,99999999999999999,0) 

&#9;bv = Instance.new(&quot;BodyVelocity&quot;) 
&#9;bv.Parent = p 
&#9;bv.maxForce = Vector3.new(4e+020, 4e+020, 4e+020) 

&#9;bf = Instance.new(&quot;BodyForce&quot;) 
&#9;bf.Parent = p 
&#9;bf.force = Vector3.new(0, 196 * p:GetMass(), 0) 

&#9;char.Torso.Neck.C0 = CFrame.new(0,0,0) * CFrame.fromEulerAnglesXYZ(math.pi,math.pi,0)

&#9;belly = Instance.new(&quot;Part&quot;) 
&#9;belly.Parent = char
&#9;belly.Locked = true 
&#9;belly.TopSurface = 0 
&#9;belly.BottomSurface = 0 
&#9;belly.CanCollide = true 
&#9;belly.Transparency = 0 
&#9;belly.formFactor = 0 
&#9;belly.Size = Vector3.new(2,1,1)
&#9;belly.Name = &quot;Belly&quot;
&#9;belly.BrickColor = BrickColor.new(150)

&#9;mesh = Instance.new(&quot;SpecialMesh&quot;)
&#9;mesh.MeshType = &quot;Head&quot;
&#9;mesh.Parent = belly
&#9;mesh.Scale = Vector3.new(1, 1.7, 1.5)

&#9;mesh2 = Instance.new(&quot;SpecialMesh&quot;)
&#9;mesh2.MeshType = &quot;FileMesh&quot;
&#9;mesh2.MeshId = &quot;http://www.roblox.com/asset/?id=23264294&quot;
&#9;mesh2.TextureId = &quot;http://www.roblox.com/asset/?id=23264295&quot;
&#9;mesh2.Parent = char.Head
&#9;mesh2.Scale = Vector3.new(1, 1, 1)
&#9;mesh2.Name = &quot;Bathead&quot;

&#9;weld = Instance.new(&quot;Weld&quot;) 
&#9;weld.Parent = char.Head 
&#9;weld.Name = &quot;BellyWeld&quot; 
&#9;weld.Part0 = w.Parent 
&#9;weld.Part1 = belly 
&#9;weld.C0 = CFrame.new(0,0,-0.8) * CFrame.fromEulerAnglesXYZ(math.pi/2,math.pi/2,0) 

&#9;local t = game:GetService(&quot;InsertService&quot;):LoadAsset(19399858)
&#9;print(&quot;model loaded&quot;)
&#9;t.Parent = char
&#9;local characterparts = char:GetChildren()
&#9;for z = 1, #characterparts do
&#9;&#9;if characterparts[z].className == &quot;Hat&quot; then
&#9;&#9;&#9;characterparts[z].Handle.Transparency = 1
&#9;&#9;&#9;characterparts[z].Name = &quot;OldHat&quot;
&#9;&#9;end
&#9;end
&#9;local model = char.Model
&#9;local modelparts = model:GetChildren()
&#9;for b = 1, #modelparts do
&#9;&#9;local tool = modelparts[b]
&#9;&#9;tool.Parent = char
&#9;&#9;tool.Name = &quot;Hat&quot;
&#9;&#9;if tool.Handle ~= nil then
&#9;&#9;&#9;tool.Handle.Locked = true
&#9;&#9;&#9;tool.Handle.Mesh.TextureId = &quot;http://www.roblox.com/asset/?id=36442826&quot;
&#9;&#9;end
&#9;&#9;print(&quot;hat put into character&quot;)
&#9;end

&#9;for c = 1, #characterparts do
&#9;&#9;if characterparts[c].Name == &quot;Model&quot; then
&#9;&#9;&#9;characterparts[c]:remove()
&#9;&#9;end
&#9;&#9;if characterparts[c].className == &quot;Part&quot; then
&#9;&#9;&#9;if characterparts[c].Name ~= &quot;Head&quot; and characterparts[c].Name ~= &quot;Belly&quot; then
&#9;&#9;&#9;&#9;characterparts[c].Transparency = 1
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end

&#9;while hold == true do 
&#9;&#9;wait() 
&#9;&#9;char.Humanoid.Sit = true 
&#9;&#9;bv.velocity = mouse.Hit.lookVector * u 
&#9;&#9;bg.cframe = CFrame.new(bg.Parent.Position, mouse.Hit.p) 
&#9;&#9;a = char.Torso 
&#9;&#9;a[&quot;Left Hip&quot;].DesiredAngle = 0 
&#9;&#9;a[&quot;Right Hip&quot;].DesiredAngle = 0 
&#9;&#9;a[&quot;Right Shoulder&quot;].DesiredAngle = 3.1 
&#9;&#9;a[&quot;Left Shoulder&quot;].DesiredAngle = 3.1 
&#9;end 
end 

function onKeyDown(key) 
&#9;if (key:lower() == &quot;v&quot;) then 
&#9;&#9;wait() 
&#9;&#9;u = u + 1 
&#9;&#9;hint.Text = &quot;User: &quot;..script.Parent.Parent.Parent.Name..&quot;|Speed: &quot;..u..&quot;|AddValue: &quot;..add..&quot;|Hover: &quot;..mode 
&#9;end 

&#9;if (key:lower() == &quot;x&quot;) then 
&#9;&#9;wait() 
&#9;&#9;u = u - 1 
&#9;&#9;hint.Text = &quot;User: &quot;..script.Parent.Parent.Parent.Name..&quot;|Speed: &quot;..u..&quot;|AddValue: &quot;..add..&quot;|Hover: &quot;..mode 
&#9;end 

&#9;if (key:lower() == &quot;z&quot;) then 
&#9;&#9;wait() 
