			</Item>
			<Item class="Script" referent="RBX13340">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">PaintballShooter</string>
					<ProtectedString name="Source">Tool = script.Parent

function fire(v)
&#9;

&#9;local vCharacter = Tool.Parent
&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;local missile = Instance.new(&quot;Part&quot;)

        

&#9;local spawnPos = vCharacter.PrimaryPart.Position
&#9;


&#9;spawnPos  = spawnPos + (v * 5)

&#9;missile.Position = spawnPos
&#9;missile.formFactor = &quot;Symmetric&quot;
&#9;missile.Size = Vector3.new(1,1,1)
&#9;missile.Velocity = v * 50
&#9;missile.Shape = 0
&#9;missile.BottomSurface = 0
&#9;missile.TopSurface = 0
&#9;missile.Name = &quot;tele1&quot;
&#9;missile.Elasticity = 0
&#9;missile.Reflectance = 0
&#9;missile.Friction = .9

&#9;local force = Instance.new(&quot;BodyForce&quot;)
&#9;force.force = Vector3.new(0,80,0)
&#9;force.Parent = missile
&#9;
&#9;local q = Tool.Teleporter:Clone()
&#9;&#9;q.Parent = missile
&#9;&#9;q.Disabled = false
&#9;local w = Tool.Enabledd:Clone()
&#9;&#9;w.Parent = missile

&#9;local new_script = script.Parent.BulletFunctions:clone()
&#9;new_script.Disabled = false
&#9;new_script.Parent = missile

&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag.Value = vPlayer
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = missile
&#9;


&#9;missile.Parent = game.Workspace

end



Tool.Enabled = true
function onActivated()

&#9;if not Tool.Enabled then
&#9;&#9;return
&#9;end

&#9;Tool.Enabled = false

&#9;local character = Tool.Parent;
&#9;local humanoid = character.Humanoid
&#9;if humanoid == nil then
&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;return 
&#9;end

&#9;local targetPos = humanoid.TargetPoint
&#9;local lookAt = (targetPos - character.Head.Position).unit

&#9;fire(lookAt)

&#9;wait(1)

&#9;Tool.Enabled = true
end


script.Parent.Activated:connect(onActivated)

</ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX13341">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui</string>
					<ProtectedString name="Source">local Tool = script.Parent;

enabled = true
function onButton1Down(mouse)
&#9;if not enabled then
&#9;&#9;return
&#9;end

&#9;enabled = false
&#9;mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;

&#9;wait(1)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;enabled = true

end

function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end


Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX13342">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Teleporter</string>
					<ProtectedString name="Source">--

--Enter the name of the model you want to go to here. In Explorer, find the name of the brick, and drag or copy
-- An &quot;Enabled&quot; to it. It should work. (It will, if you don&apos;t type it wrong.)
------------------------------------
modelname=&quot;tele2&quot; 
------------------------------------
--          ^ Name that.

function onTouched(part)
&#9;if part.Parent ~= nil then
&#9;local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;if h~=nil then
&#9;&#9;&#9;local teleportfrom=script.Parent.Enabledd.Value
&#9;&#9;&#9;if teleportfrom~=0 then
&#9;&#9;&#9;&#9;if h==humanoid then
&#9;&#9;&#9;&#9;return
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;local teleportto=script.Parent.Parent:findFirstChild(modelname)
&#9;&#9;&#9;&#9;if teleportto~=nil then
&#9;&#9;&#9;&#9;&#9;local torso = h.Parent.Torso
&#9;&#9;&#9;&#9;&#9;local location = {teleportto.Position}
&#9;&#9;&#9;&#9;&#9;local i = 1

&#9;&#9;&#9;&#9;&#9;local x = location[i].x
&#9;&#9;&#9;&#9;&#9;local y = location[i].y
&#9;&#9;&#9;&#9;&#9;local z = location[i].z
&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;x = x + math.random(-1, 1)
&#9;&#9;&#9;&#9;&#9;z = z + math.random(-1, 1)
&#9;&#9;&#9;&#9;&#9;y = y + math.random(2, 3)

&#9;&#9;&#9;&#9;&#9;local cf = torso.CFrame
&#9;&#9;&#9;&#9;&#9;local lx = 0
&#9;&#9;&#9;&#9;&#9;local ly = y
&#9;&#9;&#9;&#9;&#9;local lz = 0
&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;local m = Instance.new(&quot;Message&quot;)
&#9;&#9;&#9;&#9;&#9;m.Parent = game.Players[h.Parent.Name]
&#9;&#9;&#9;&#9;&#9;m.Text = &quot;You have been sent to jail!&quot;
&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;script.Parent.Enabledd.Value=0
&#9;&#9;&#9;&#9;&#9;teleportto.Enabledd.Value=0
&#9;&#9;&#9;&#9;&#9;torso.CFrame = CFrame.new(Vector3.new(x,y,z), Vector3.new(lx,ly,lz))
&#9;&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;&#9;game.Players[h.Parent.Name].Message:Remove()
&#9;&#9;&#9;&#9;&#9;script.Parent.Enabledd.Value=1
&#9;&#9;&#9;&#9;&#9;teleportto.Enabledd.Value=1
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;print(&quot;Could not find teleporter!&quot;)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
				</Properties>
			</Item>
