						<string name="Name">Script</string>
						<ProtectedString name="Source">function onButtonClicked()
x = script.Parent.Parent.Parent.Parent.Character:GetChildren()
if not x then return end
for i=1, #x do
if x[i].Name == &quot;Vehicle&quot; then
x[i]:Remove()
end
end
end
