&#9;&#9;w1.Part0 = w1.Parent
&#9;&#9;w1.Part1 = newpart
&#9;&#9;w1.C1 = CFrame.new(0, -0.4, 0) &#9;&#9;&#9;&#9;
&#9;&#9;local mesh1 = Instance.new(&quot;SpecialMesh&quot;) 
