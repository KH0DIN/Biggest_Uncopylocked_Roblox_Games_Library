function PaintMe(part)
&#9;local allstuff = char:GetChildren()
&#9;if frame.Colors.Parts.Value == &quot;head&quot; then
&#9;&#9;char:findFirstChild(&quot;Body Colors&quot;).HeadColor = part.BackgroundColor
&#9;end
&#9;if frame.Colors.Parts.Value == &quot;allbuthead&quot; then
&#9;&#9;for as = 1, #allstuff do
&#9;&#9;&#9;if allstuff[as].Name ~= &quot;Head&quot; and allstuff[as].className == &quot;Part&quot; then
&#9;&#9;&#9;&#9;allstuff[as].BrickColor = part.BackgroundColor
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;char:findFirstChild(&quot;Body Colors&quot;).LeftArmColor = part.BackgroundColor
&#9;&#9;char:findFirstChild(&quot;Body Colors&quot;).LeftLegColor = part.BackgroundColor
&#9;&#9;char:findFirstChild(&quot;Body Colors&quot;).RightArmColor = part.BackgroundColor
&#9;&#9;char:findFirstChild(&quot;Body Colors&quot;).RightLegColor = part.BackgroundColor
&#9;&#9;char:findFirstChild(&quot;Body Colors&quot;).TorsoColor = part.BackgroundColor
&#9;end
&#9;if frame.Colors.Parts.Value == &quot;all&quot; then
&#9;&#9;for as = 1, #allstuff do
&#9;&#9;&#9;if allstuff[as].className == &quot;Part&quot; then
&#9;&#9;&#9;&#9;allstuff[as].BrickColor = part.BackgroundColor
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;char:findFirstChild(&quot;Body Colors&quot;).LeftArmColor = part.BackgroundColor
&#9;&#9;char:findFirstChild(&quot;Body Colors&quot;).LeftLegColor = part.BackgroundColor
&#9;&#9;char:findFirstChild(&quot;Body Colors&quot;).RightArmColor = part.BackgroundColor
&#9;&#9;char:findFirstChild(&quot;Body Colors&quot;).RightLegColor = part.BackgroundColor
&#9;&#9;char:findFirstChild(&quot;Body Colors&quot;).TorsoColor = part.BackgroundColor
&#9;&#9;char:findFirstChild(&quot;Body Colors&quot;).HeadColor = part.BackgroundColor
&#9;end&#9;
&#9;if frame.Colors.Parts.Value == &quot;torso&quot; then
&#9;&#9;char.Torso.BrickColor = part.BackgroundColor
&#9;&#9;char:findFirstChild(&quot;Body Colors&quot;).TorsoColor = part.BackgroundColor
&#9;end
&#9;if frame.Colors.Parts.Value == &quot;leftleg&quot; then
&#9;&#9;char:findFirstChild(&quot;Left Leg&quot;).BrickColor = part.BackgroundColor
&#9;&#9;char:findFirstChild(&quot;Body Colors&quot;).LeftLegColor = part.BackgroundColor
&#9;end
&#9;if frame.Colors.Parts.Value == &quot;rightleg&quot; then
&#9;&#9;char:findFirstChild(&quot;Body Colors&quot;).RightLegColor = part.BackgroundColor
&#9;end
&#9;if frame.Colors.Parts.Value == &quot;leftarm&quot; then
&#9;&#9;char:findFirstChild(&quot;Left Arm&quot;).BrickColor = part.BackgroundColor
&#9;&#9;char:findFirstChild(&quot;Body Colors&quot;).LeftArmColor = part.BackgroundColor
&#9;end
&#9;if frame.Colors.Parts.Value == &quot;rightarm&quot; then
&#9;&#9;char:findFirstChild(&quot;Right Arm&quot;).BrickColor = part.BackgroundColor
&#9;&#9;char:findFirstChild(&quot;Body Colors&quot;).RightArmColor = part.BackgroundColorZ
&#9;end&#9;
end

function MeshMe(part)
&#9;if char:findFirstChild(&quot;IsaMorph&quot;) == nil then
&#9;&#9;local allstuff = char:GetChildren()
&#9;&#9;if frame.Colors.Parts.Value == &quot;head&quot; then return end
&#9;&#9;if frame.Colors.Parts.Value == &quot;allbuthead&quot; then
&#9;&#9;&#9;for as = 1, #allstuff do
&#9;&#9;&#9;&#9;if allstuff[as].className == &quot;CharacterMesh&quot; then
&#9;&#9;&#9;&#9;&#9;allstuff[as]:remove()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;local meshes = part:GetChildren()
&#9;&#9;&#9;for m = 1, #meshes do
&#9;&#9;&#9;&#9;local newmesh = Instance.new(&quot;CharacterMesh&quot;)
&#9;&#9;&#9;&#9;newmesh.BaseTextureId = meshes[m].BaseTextureId
