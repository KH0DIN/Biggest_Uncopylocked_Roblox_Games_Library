			<Item class="LocalScript" referent="RBX13545">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui</string>
					<ProtectedString name="Source">local Tool = script.Parent;

enabled = true

function onButton1Down(mouse)
&#9;if not enabled  then
&#9;&#9;return
&#9;end

&#9;enabled = false
&#9;Tool.GripForward = Vector3.new(0,-.759,-.651)
&#9;Tool.GripPos = Vector3.new(1.5,-.5,.3)
&#9;Tool.GripRight = Vector3.new(1,0,0)
&#9;Tool.GripUp = Vector3.new(0,.651,-.759)

&#9;Tool.Handle.DrinkSound:Play()

&#9;wait(3)
&#9;
&#9;local h = Tool.Parent.Humanoid
&#9;if (h ~= nil) then
&#9;&#9;if (h.MaxHealth &gt; h.Health + 20) then
&#9;&#9;&#9;h.Health = h.Health + 20
&#9;&#9;else&#9;
&#9;&#9;&#9;h.Health = h.MaxHealth
&#9;&#9;end
&#9;end

&#9;Tool.Parent.Humanoid.Health = Tool.Parent.Humanoid.Health + 0
&#9;Tool.GripForward = Vector3.new(0,0,-1)
&#9;Tool.GripPos = Vector3.new(.15,0,.3)
&#9;Tool.GripRight = Vector3.new(1,0,0)
&#9;Tool.GripUp = Vector3.new(0,1,0)

&#9;enabled = true
&#9;Tool.Handle.DrinkSound:Stop()
&#9;--script.Parent:remove()

end

function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end


Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
