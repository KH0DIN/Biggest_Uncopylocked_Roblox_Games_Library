		<Item class="Script" referent="RBX912">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Remover</string>
				<ProtectedString name="Source">function Added(Model)
--wait(.1);
if Model == nil then return end
if Model.Name == &quot;Health&quot; or Model.Name == &quot;RobloxTeam&quot; or Model.Name == &quot;Body Colors&quot; then
if Model == nil then return end
print(&quot;Removed unwanted crap.&quot;);
Model:remove();
end
end
game.Workspace.DescendantAdded:connect(Added)</ProtectedString>
