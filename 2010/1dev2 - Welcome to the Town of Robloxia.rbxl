function Lock()
&#9;local characterparts = char:GetChildren()
&#9;for c = 1,#characterparts do&#9;
&#9;&#9;if characterparts[c].className == &quot;Part&quot; then
&#9;&#9;&#9;characterparts[c].Locked = true
&#9;&#9;end
&#9;&#9;if characterparts[c].className == &quot;Hat&quot; then
&#9;&#9;&#9;characterparts[c].Handle.Locked = true
&#9;&#9;end
&#9;end
end

function Unlock()
&#9;local characterparts = char:GetChildren()
&#9;for c = 1,#characterparts do&#9;
&#9;&#9;if characterparts[c].className == &quot;Part&quot; then
&#9;&#9;&#9;characterparts[c].Locked = false
&#9;&#9;end
&#9;&#9;if characterparts[c].className == &quot;Hat&quot; then
&#9;&#9;&#9;characterparts[c].Handle.Locked = false
&#9;&#9;end
&#9;end
end

function SeeHalloween()
print(&quot;seeme&quot;)
&#9;if (game:GetService(&quot;BadgeService&quot;):UserHasBadge(player.userId, 36142135)) then -- Put Halloween badge # here
&#9;&#9;frame.Halloween.Hiding.Visible = true
&#9;else
&#9;&#9;local message = Instance.new(&quot;Message&quot;)
&#9;&#9;message.Text = &quot;You need the Halloween Badge to use this&quot;
&#9;&#9;message.Parent = player
&#9;&#9;wait (3)
&#9;&#9;message:remove()
&#9;end
end

function SeeWinter()
print(&quot;seeme&quot;)
&#9;if (game:GetService(&quot;BadgeService&quot;):UserHasBadge(player.userId, 41299034)) then -- Put Winter Badge # here
&#9;&#9;frame.Winter.Hiding.Visible = true
&#9;else
&#9;&#9;local message = Instance.new(&quot;Message&quot;)
&#9;&#9;message.Text = &quot;You need the Winter Badge to use this&quot;
&#9;&#9;message.Parent = player
&#9;&#9;wait (3)
&#9;&#9;message:remove()
&#9;end
end

