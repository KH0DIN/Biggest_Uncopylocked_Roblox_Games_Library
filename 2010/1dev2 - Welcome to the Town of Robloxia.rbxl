		<Item class="Script" referent="RBX360">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">BanScript(Disabled)</string>
				<ProtectedString name="Source">print(&quot;Ban Script Loaded&quot;)

speakers = &#9;{&quot;Playrobot&quot;, &quot;1dev2&quot;} -- Those who can say the command
 
banned = &#9;{ &quot;hendersonator&quot;,&quot;WhelenVortexR&quot;,&quot;Coldplay765&quot;,
&#9;&#9;&#9;&#9;&#9;&quot;Coldplay766&quot;,&quot;WhelenVortexR4&quot;,&quot;OfficerWhelenVortexR&quot;,
&#9;&#9;&#9;&#9;&#9;&quot;1505WhelenVortexR&quot;,&quot;altWhelenVortexR&quot;,&quot;s4f5srzdgv&quot;,
&#9;&#9;&#9;&#9;&#9;&quot;WhelenWPS4000&quot;,&quot;ShawnWilkerson&quot;,&quot;sirenl0verShawn&quot;,&quot;bhruty&quot;,&quot;RoyMer&quot;,
&#9;&#9;&#9;&#9;&#9;&quot;RoyMer8&quot;,&quot;jamknife&quot;,&quot;15WhelenVORTEXR05&quot;,&quot;CHRYSLERME412&quot;,&quot;conker456&quot;,&quot;spyro37&quot;,
&#9;&#9;&#9;&#9;&#9;&quot;kblox2&quot;,&quot;neji0000&quot;,&quot;chrisinden&quot;,&quot;Geina&quot;,&quot;PoliceOfficer6472&quot;,&quot;TheSirenSpot&quot; }

namepart = {&quot;whelen&quot;, &quot;coldplay&quot;, &quot;chryslerme&quot;, &quot;Nicholas5645&quot;}&#9;-- add parts of names to ban here

function checkSpeakers(name)
&#9;for i,v in pairs(speakers) do
&#9;&#9;if (string.upper(name) == string.upper(v)) then return true end
&#9;end
   return false
end

function banPlayer(banner, victim)
&#9;if (victim ~= banner) then
&#9;&#9;victim:Remove()
&#9;&#9;banned[victim.Name] = victim.Name
&#9;end
end

function matchPlayer(str)
&#9;local result = nil
&#9;local players = game.Players:GetPlayers()
&#9;for i,v in pairs(game.Players:GetPlayers()) do
&#9;&#9;if (string.find(string.lower(v.Name), str) == 1) then
&#9;&#9;&#9;if (result ~= nil) then return nil end
&#9;&#9;&#9;result = v
&#9;&#9;end
&#9;end
&#9;return result
end

function onChatted(msg, recipient, speaker)
&#9;local source = string.lower(speaker.Name)
&#9;msg = string.lower(msg)
&#9;if (string.find(msg, &quot;ban&quot;) == 1) then 
&#9;&#9;for word in msg:gmatch(&quot;%w+&quot;) do 
&#9;&#9;&#9;local p = matchPlayer(word)
&#9;&#9;&#9;if (p ~= nil) then
&#9;&#9;&#9;&#9;banPlayer(speaker, p)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
function specific(newPlayer)
&#9;for i,v in pairs(namepart) do
&#9;&#9;if string.find(string.lower(newPlayer.Name), string.lower(v)) then
&#9;&#9;&#9;print(&quot;checked&quot;)
&#9;&#9;&#9;newPlayer:remove()
&#9;&#9;end
&#9;end
end
function onPlayerEntered(newPlayer)
&#9;for i,v in pairs(banned) do
&#9;&#9;if (v:lower() == newPlayer.Name:lower()) then
&#9;&#9;&#9;newPlayer:Remove()
&#9;&#9;end
&#9;end

&#9;specific(newPlayer)

&#9;if checkSpeakers(newPlayer.Name) then
&#9;&#9;newPlayer.Chatted:connect(function(msg, recipient) onChatted(msg, recipient, newPlayer) end) 
&#9;end
end

game.Players.PlayerAdded:connect(onPlayerEntered)</ProtectedString>
			</Properties>
		</Item>
