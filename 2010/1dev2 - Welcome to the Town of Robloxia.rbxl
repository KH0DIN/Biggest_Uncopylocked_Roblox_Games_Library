function Mangler()
&#9;if char:findFirstChild(&quot;IsaMorph&quot;) == nil then
&#9;&#9;local length = 3
&#9;&#9;local color = 1003
&#9;&#9;local script2 = script.ManglerAnimation:clone()
&#9;&#9;local script3 = script.ManglerSegmentScript:clone()
&#9;&#9;local head = char.Head
&#9;&#9;local mesh = head:findFirstChild(&quot;Mesh&quot;) 
&#9;&#9;mesh.MeshType = &quot;FileMesh&quot;
&#9;&#9;mesh.MeshId = &quot;http://www.roblox.com/asset/?id=24103726&quot;
&#9;&#9;mesh.Scale = Vector3.new(1.3, 1, 0.85) 
&#9;&#9;mesh.TextureId= &quot;http://www.roblox.com/asset/?id=24103714&quot;
&#9;&#9;local face = head.face
&#9;&#9;local torso = char.Torso
&#9;&#9;torso.Transparency = 1
&#9;&#9;torso.CanCollide = false
&#9;&#9;local w1 = Instance.new(&quot;Weld&quot;) 
&#9;&#9;w1.Parent = torso
&#9;&#9;w1.Part0 = w1.Parent
&#9;&#9;w1.Part1 = head
&#9;&#9;w1.C1 = CFrame.new(0, 1.8, 0.8)
&#9;&#9;local newXcoordinate = head.Position.x
&#9;&#9;local newYcoordinate = head.Position.y
&#9;&#9;local newZcoordinate = head.Position.z
&#9;&#9;-----------------------------------
&#9;&#9;--SEGMENTS
&#9;&#9;------------------------------------
&#9;&#9;local part1 = Instance.new(&quot;Part&quot;) 
&#9;&#9;part1.Transparency = 0 
&#9;&#9;part1.Locked = true 
&#9;&#9;part1.Size = Vector3.new(2.5,2.5,length) --length of each part -- size of each part! 
&#9;&#9;part1.Anchored = true 
&#9;&#9;part1.CanCollide = false 
&#9;&#9;part1.Parent = char 
&#9;&#9;part1.Name = &quot;Part1&quot; 
&#9;&#9;part1.CFrame = CFrame.new(Vector3.new(newXcoordinate + 1, newYcoordinate, newZcoordinate)) 
&#9;&#9;local mesh1 = Instance.new(&quot;SpecialMesh&quot;) 
&#9;&#9;mesh1.MeshType = &quot;Sphere&quot;
&#9;&#9;mesh1.Scale = Vector3.new(1, 1, 1) 
&#9;&#9;mesh1.Parent = part1
&#9;&#9;local part2 = part1:Clone() 
&#9;&#9;part2.Parent = char 
&#9;&#9;part2.Name = &quot;Part2&quot; 
&#9;&#9;part2.CFrame = CFrame.new(Vector3.new(newXcoordinate + 2, newYcoordinate, newZcoordinate)) 
&#9;&#9;local part3 = part2:Clone() 
&#9;&#9;part3.Parent = char
&#9;&#9;part3.Name = &quot;Part3&quot; 
&#9;&#9;part3.CFrame =CFrame.new(Vector3.new(newXcoordinate + 3, newYcoordinate, newZcoordinate)) 
&#9;&#9;local part4 = part3:Clone() 
&#9;&#9;part4.Parent = char
&#9;&#9;part4.Name = &quot;Part4&quot; 
&#9;&#9;part4.CFrame = CFrame.new(Vector3.new(newXcoordinate + 4, newYcoordinate, newZcoordinate)) 
&#9;&#9;local part5 = part4:Clone() 
&#9;&#9;part5.Parent = char 
&#9;&#9;part5.Name = &quot;Part5&quot; 
&#9;&#9;part5.CFrame = CFrame.new(Vector3.new(newXcoordinate + 5, newYcoordinate, newZcoordinate)) 
&#9;&#9;local part6 = part5:Clone() 
&#9;&#9;part6.Parent = char 
&#9;&#9;part6.Name = &quot;Part6&quot; 
&#9;&#9;part6.CFrame = CFrame.new(Vector3.new(newXcoordinate + 6, newYcoordinate, newZcoordinate)) 
&#9;&#9;local part7 = part6:Clone() 
&#9;&#9;part7.Parent = char 
&#9;&#9;part7.Name = &quot;Part7&quot; 
&#9;&#9;part7.CFrame = CFrame.new(Vector3.new(newXcoordinate + 7, newYcoordinate, newZcoordinate)) 
&#9;&#9;local part8 = part7:Clone() 
&#9;&#9;part8.Parent = char 
&#9;&#9;part8.Name = &quot;Part8&quot; 
&#9;&#9;part8.CFrame = CFrame.new(Vector3.new(newXcoordinate + 8, newYcoordinate, newZcoordinate)) 
&#9;&#9;local part9 = part8:Clone() 
&#9;&#9;part9.Parent = char 
&#9;&#9;part9.Name = &quot;Part9&quot; 
&#9;&#9;part9.CFrame = CFrame.new(Vector3.new(newXcoordinate + 9, newYcoordinate, newZcoordinate)) 
&#9;&#9;local part10 = part9:Clone() 
&#9;&#9;part10.Parent = char 
&#9;&#9;part10.Name = &quot;Part10&quot; 
&#9;&#9;part10.CFrame = CFrame.new(Vector3.new(newXcoordinate + 10, newYcoordinate, newZcoordinate)) 
&#9;&#9;----------------------------------
&#9;&#9;--ARMS AND LEGS
&#9;&#9;----------------------------------
&#9;&#9;local rightarm = char:findFirstChild(&quot;Right Arm&quot;)
&#9;&#9;if rightarm ~= nil then
&#9;&#9;&#9;local armmesh = Instance.new(&quot;SpecialMesh&quot;)
&#9;&#9;&#9;armmesh.Scale = Vector3.new(0.2, 0.12, 0.3)
&#9;&#9;&#9;armmesh.Parent = rightarm
&#9;&#9;end
&#9;&#9;rightarm.Transparency = 1
&#9;&#9;local rightleg = char:findFirstChild(&quot;Right Leg&quot;)
&#9;&#9;if rightleg~= nil then
&#9;&#9;&#9;local legmesh = Instance.new(&quot;SpecialMesh&quot;)
&#9;&#9;&#9;legmesh.Scale = Vector3.new(0.2, 0.12, 0.3)
&#9;&#9;&#9;legmesh.Parent = rightleg
&#9;&#9;end
&#9;&#9;rightleg.Transparency = 1
&#9;&#9;local leftarm = char:findFirstChild(&quot;Left Arm&quot;)
&#9;&#9;if leftarm~= nil then
&#9;&#9;&#9;local armmesh = Instance.new(&quot;SpecialMesh&quot;)
&#9;&#9;&#9;armmesh.Scale = Vector3.new(0.2, 0.12, 0.3)
&#9;&#9;&#9;armmesh.Parent = leftarm
&#9;&#9;end
&#9;&#9;leftarm.Transparency = 1
&#9;&#9;local leftleg = char:findFirstChild(&quot;Left Leg&quot;)
&#9;&#9;if leftleg ~= nil then
&#9;&#9;&#9;local legmesh = Instance.new(&quot;SpecialMesh&quot;)
&#9;&#9;&#9;legmesh.Scale = Vector3.new(0.2, 0.12, 0.3)
&#9;&#9;&#9;legmesh.Parent = leftleg
&#9;&#9;end
&#9;&#9;leftleg.Transparency = 1
&#9;&#9;--------------------------
&#9;&#9;---OTHER STUFF
&#9;&#9;--------------------------
&#9;&#9;local marker = Instance.new(&quot;StringValue&quot;)
&#9;&#9;marker.Parent = char
&#9;&#9;marker.Name = &quot;IsaMorph&quot;
&#9;&#9;script2.Parent = char
&#9;&#9;script3.Parent = char
&#9;&#9;local characterparts = char:getChildren() 
&#9;&#9;for i=1,#characterparts do 
&#9;&#9;&#9;if characterparts[i].className == &quot;Pants&quot; then
&#9;&#9;&#9;&#9;characterparts[i]:remove()
&#9;&#9;&#9;end
&#9;&#9;&#9;if characterparts[i].className == &quot;Shirt&quot; then
&#9;&#9;&#9;&#9;characterparts[i]:remove()
&#9;&#9;&#9;end
&#9;&#9;&#9;if characterparts[i].className == &quot;CharacterMesh&quot; then
&#9;&#9;&#9;&#9;characterparts[i]:remove()
&#9;&#9;&#9;end
&#9;&#9;&#9;if characterparts[i].className == &quot;Part&quot; then 
&#9;&#9;&#9;&#9;characterparts[i].Locked = true 
&#9;&#9;&#9;&#9;characterparts[i].BottomSurface = &quot;Smooth&quot;
&#9;&#9;&#9;&#9;characterparts[i].TopSurface = &quot;Weld&quot;
&#9;&#9;&#9;&#9;characterparts[i].BrickColor = BrickColor.new(color)
&#9;&#9;&#9;end 
&#9;&#9;&#9;if characterparts[i].className == &quot;Hat&quot; then 
&#9;&#9;&#9;&#9;characterparts[i]:remove()
&#9;&#9;&#9;end 
&#9;&#9;end 
&#9;&#9;local bodycolors = char:findFirstChild(&quot;Body Colors&quot;)
&#9;&#9;bodycolors.LeftArmColor = BrickColor.new(color)
&#9;&#9;bodycolors.LeftLegColor = BrickColor.new(color)
&#9;&#9;bodycolors.RightArmColor = BrickColor.new(color)
&#9;&#9;bodycolors.RightLegColor = BrickColor.new(color)
&#9;&#9;bodycolors.TorsoColor = BrickColor.new(color)
&#9;&#9;bodycolors.HeadColor = BrickColor.new(color)
&#9;end
end
